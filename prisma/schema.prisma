// BHV Practice Management — core data model (T02, PRD §33 DAT01-03).
//
// Three rules shape everything below:
//
// DAT01  Every financial/professional record carries a non-null practiceId,
//        and every cross-record reference is a COMPOSITE foreign key that
//        includes practiceId. Postgres therefore rejects a reference that
//        crosses practices — the app cannot leak by forgetting a filter.
//        Money is Decimal(18,2) with an explicit currency; statutory dates
//        are date-only; instants are UTC timestamptz, interpreted against
//        Practice.jurisdictionTimeZone.
// DAT02  History is never rewritten. Issued invoices and accepted
//        engagements freeze their particulars into a snapshot; approvals
//        keep the actor's name; roles/registrations/rules carry effective
//        intervals rather than being edited in place.
// DAT03  Ordinary removal sets archivedAt (reversible). Destructive purge
//        is a separate retention-controlled process, not modelled here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Practice / membership
// ---------------------------------------------------------------------------

enum PracticeConstitution {
  PROPRIETORSHIP
  PARTNERSHIP
  LLP
}

enum RegistrationKind {
  FRN
  PAN
  TAN
  GSTIN
}

// IAM02. Note the deliberate split at the bottom: IT_ADMIN is an
// infrastructure role and carries NO professional data authority, while
// QUALITY_REVIEWER carries professional authority and no infrastructure
// rights. Conflating the two is how an IT account ends up able to sign a
// filing.
enum PracticeRole {
  GROUP_OWNER
  PRACTICE_PARTNER
  MANAGER
  REVIEWER
  STAFF_ARTICLE
  FINANCE
  HR
  IT_ADMIN
  QUALITY_REVIEWER
  CLIENT_CONTACT
}

// IAM03: how far a membership's authority reaches.
enum AssignmentScope {
  OWN_WORK
  ASSIGNED_ENGAGEMENTS
  TEAM
  BRANCH
  PRACTICE
  COMBINED
}

// IAM03: areas that stay denied even to senior roles unless an explicit
// additional permission exists.
enum RestrictedPermission {
  HR_RECORDS
  CREDENTIALS
  FEE_RATES
  PROTECTED_WORKPAPERS
  CREDENTIAL_EXPORT
}

/// UX01: "Provide Light, Dark and System settings saved per user." SYSTEM is
/// a real third value, not the absence of a choice — a user who wants to
/// follow the OS has chosen that, and it must survive a device change.
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

/// UX02: "optional comfortable density".
enum Density {
  COMFORTABLE
  COMPACT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archivedAt DateTime?

  practiceGroups   PracticeGroup[]
  practices        Practice[]
  parties          Party[]
  events           Event[]
  messageTemplates MessageTemplate[]
}

// ORG01: BHV initially uses one group with two practices. The group exists
// so a combined view is an explicit permission, never an automatic
// consequence of two practices sharing a tenant.
model PracticeGroup {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  name     String

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  practices Practice[]

  @@unique([tenantId, name])
}

model Practice {
  id              String               @id @default(uuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  practiceGroupId String?
  practiceGroup   PracticeGroup?       @relation(fields: [practiceGroupId], references: [id])
  name            String
  constitution    PracticeConstitution

  // ORG02: registered display name may differ from the internal name, and
  // the identifier holder is a verified fact — never assumed. Left null
  // until onboarding confirms it (see PROGRESS.md open questions).
  registeredDisplayName String?
  identifierHolderName  String?
  identifierHolderVerifiedAt DateTime?

  // ORG04: document namespace is independent per practice — object keys are
  // prefixed with it so two practices cannot collide or enumerate each other.
  documentNamespace String @unique

  // ORG01 edge case: a deactivated practice stays READ ONLY under retention
  // and legal hold rules rather than disappearing.
  readOnlyFrom DateTime?

  // DAT01: instants are UTC; this is the timezone statutory dates and
  // business-day maths are interpreted in for this practice.
  jurisdictionTimeZone String @default("Asia/Kolkata")

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  registrations       PracticeRegistration[]
  addresses           PracticeAddress[]
  bankAccounts        PracticeBankAccount[]
  letterheads         PracticeLetterhead[]
  signatories         AuthorisedSignatory[]
  sharesGranted       CrossPracticeShare[]  @relation("SharingPractice")
  sharesReceived      CrossPracticeShare[]  @relation("ReceivingPractice")
  branches            Branch[]
  teams               Team[]
  memberships         PracticeMembership[]
  clientRelationships ClientRelationship[]
  engagements         Engagement[]
  jobs                Job[]
  tasks               Task[]
  obligations         Obligation[]
  documents           Document[]
  invoiceSeries       InvoiceSeries[]
  invoices            Invoice[]
  receipts            Receipt[]
  allocations         ReceiptAllocation[]
  outboundMessages    OutboundMessage[]
  approvals           Approval[]
  selfReviewExceptions SelfReviewException[]
  dscCustodyRecords   DscCustodyRecord[]
  events              Event[]
  documentIntakes     DocumentIntake[]
  documentSets        DocumentSet[]
  retentionPolicies   RetentionPolicy[]
  legalHolds          LegalHold[]
  supportContacts     PracticeSupportContact[]
  feeArrangements     FeeArrangement[]
  creditNotes         CreditNote[]
  downtimeWorkRecords DowntimeWorkRecord[]
  processingActivities   ProcessingActivity[]
  regulatoryRequirements RegulatoryRequirement[]
  securityIncidents      SecurityIncident[]
  erasureRequests        ErasureRequest[]

  // IAM04: invoices above this value require independent review.
  invoiceApprovalThreshold Decimal @default(0) @db.Decimal(18, 2)

  @@unique([tenantId, name])
}

// DAT02: identifiers are held as effective intervals. Superseding a GSTIN
// adds a row; it never edits the value an old invoice was issued under.
model PracticeRegistration {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  kind      RegistrationKind
  value     String
  stateCode String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  verifiedAt    DateTime?
  verifiedBy    String?
  archivedAt    DateTime?

  invoiceSeries InvoiceSeries[]

  @@unique([id, practiceId])
  @@unique([practiceId, kind, value, effectiveFrom])
}

// ORG02: verified configuration with effective dates. Every one of these is
// a fact to be CONFIRMED at onboarding, not assumed — and superseding one
// adds a row so old signed artefacts keep the values they were issued under
// (ORG01 edge case: "a practice rename preserves old signed artefacts").

model PracticeAddress {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  label      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")

  isRegisteredOffice Boolean @default(false)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  verifiedAt    DateTime?
  verifiedBy    String?
  archivedAt    DateTime?

  @@unique([id, practiceId])
  @@index([practiceId, effectiveFrom])
}

// ORG04: bank mappings are independent per practice. An invoice issued by
// one practice must never quote the other's account.
model PracticeBankAccount {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  label         String
  bankName      String
  // Stored for display on invoices/letters. Real values are entered at
  // onboarding — no real account numbers belong in this repo.
  accountNumber String
  ifsc          String
  branchName    String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  verifiedAt    DateTime?
  verifiedBy    String?
  archivedAt    DateTime?

  receipts Receipt[]

  @@unique([id, practiceId])
  @@index([practiceId, effectiveFrom])
}

model PracticeLetterhead {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  label           String
  storageObjectId String?
  headerHtml      String?
  footerHtml      String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  archivedAt    DateTime?

  @@unique([id, practiceId])
  @@index([practiceId, effectiveFrom])
}

// ORG01 edge case: "a partnership change does not overwrite earlier
// signatory facts" — hence intervals, never in-place edits.
model AuthorisedSignatory {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  personName     String
  designation    String
  membershipNo   String?
  userId         String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  verifiedAt    DateTime?
  verifiedBy    String?
  archivedAt    DateTime?

  @@unique([id, practiceId])
  @@index([practiceId, effectiveFrom])
}

enum ShareSubjectType {
  DOCUMENT_VERSION
  CONTACT_FIELD
}

// ORG05: cross-practice access exists ONLY as an explicit logged grant
// naming the receiving practice, the purpose and an expiry. A grant is
// pinned to one exact subject version — a new document version does not
// inherit it. Revocation stops future access; it cannot retract copies
// already downloaded, which is recorded rather than pretended otherwise.
model CrossPracticeShare {
  id String @id @default(uuid())

  sharingPracticeId   String
  sharingPractice     Practice @relation("SharingPractice", fields: [sharingPracticeId], references: [id])
  receivingPracticeId String
  receivingPractice   Practice @relation("ReceivingPractice", fields: [receivingPracticeId], references: [id])

  subjectType    ShareSubjectType
  subjectId      String
  subjectVersion Int?

  purpose   String
  expiresAt DateTime

  grantedByUserId String?
  grantedByName   String
  grantedAt       DateTime  @default(now())
  revokedAt       DateTime?
  revokedByName   String?

  lastAccessedAt DateTime?
  accessCount    Int      @default(0)

  @@index([receivingPracticeId, expiresAt])
  @@index([subjectType, subjectId])
}

model Branch {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  name       String
  archivedAt DateTime?

  memberships PracticeMembership[]

  @@unique([id, practiceId])
  @@unique([practiceId, name])
}

model Team {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  name       String
  archivedAt DateTime?

  memberships PracticeMembership[]

  @@unique([id, practiceId])
  @@unique([practiceId, name])
}

// A person. Deliberately holds NO authentication secrets — credentials and
// MFA material arrive in T05 in a separate table, so that purging an account
// leaves this identity row intact for historical approvals (DAT03 evidence).
model User {
  id       String     @id @default(uuid())
  email    String     @unique
  fullName String
  status   UserStatus @default(INVITED)

  // IAM05 lifecycle. Authorship and historical activity survive closure —
  // only the ability to act is withdrawn.
  invitedByUserId    String?
  sponsorUserId      String?
  invitedAt          DateTime?
  acceptedAt         DateTime?
  mfaEnrolledAt      DateTime?
  lastAccessReviewAt DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?

  // UX01/UX02 display preferences, saved per user. Presentation only — they
  // carry no authority and are deliberately not part of any access decision.
  themePreference   ThemePreference @default(SYSTEM)
  densityPreference Density         @default(COMFORTABLE)

  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   PracticeMembership[]
  sessions      Session[]
  queuedJobs    QueuedJob[]
  credential    UserCredential?
  mfaEnrolments MfaEnrolment[]
  recoveryCodes MfaRecoveryCode[]
  recoveryRequests RecoveryRequest[]
  events        Event[]
}

// IAM03: an explicit, reasoned, expiring grant over a restricted area.
// Absence of a row means denied — there is no implicit seniority override.
model PermissionGrant {
  id           String             @id @default(uuid())
  practiceId   String
  membershipId String
  membership   PracticeMembership @relation(fields: [membershipId, practiceId], references: [id, practiceId])

  permission RestrictedPermission
  reason     String

  grantedByUserId String?
  grantedByName   String
  effectiveFrom   DateTime  @default(now())
  expiresAt       DateTime?
  revokedAt       DateTime?

  @@unique([membershipId, permission, effectiveFrom])
  @@index([practiceId, permission])
}

// IAM05: revocation must have something concrete to invalidate. Real session
// issuance (MFA, 30 min idle / 12 hr max) is AUTH02 in T05; the row exists
// now so revoke-on-suspend can be built and tested.
model Session {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // AUTH02: the cookie carries a random token; only its SHA-256 lives here,
  // so a database or backup copy cannot be replayed as a live session.
  tokenHash String @unique

  deviceLabel String?
  userAgent   String?

  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  mfaVerifiedAt     DateTime?

  revokedAt     DateTime?
  revokedReason String?

  stepUps StepUpChallenge[]

  @@index([userId, revokedAt])
}

enum StepUpPurpose {
  EXPORT
  ROLE_CHANGE
  SECRET_REVEAL
}

// AUTH02: "Step up authentication for exports, role changes and secret
// reveal." A satisfied challenge is narrow and short-lived — it authorises
// one purpose, not the rest of the session.
model StepUpChallenge {
  id        String  @id @default(uuid())
  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])

  purpose     StepUpPurpose
  satisfiedAt DateTime?
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  @@index([sessionId, purpose])
}

enum MfaMethod {
  TOTP
  WEBAUTHN
}

// AUTH01. Password material is scrypt-derived; the plaintext never exists
// outside the request that set it.
model UserCredential {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  passwordHash      String
  passwordUpdatedAt DateTime @default(now())
  mustChangePassword Boolean @default(false)

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// AUTH01/AUTH02. The TOTP seed is encrypted at rest with a key held outside
// the database (env/KMS), so a stolen dump does not yield working codes.
model MfaEnrolment {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  method           MfaMethod @default(TOTP)
  secretCiphertext String
  secretIv         String
  secretAuthTag    String

  confirmedAt DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  // Replay prevention: a code already spent in this time step is refused.
  lastUsedStep BigInt?

  createdAt DateTime @default(now())

  @@index([userId, revokedAt])
}

// Hashed, single-use. A recovery code is shown once at generation and is
// never recoverable from the database afterwards.
model MfaRecoveryCode {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, usedAt])
}

// AUTH03: single-use, expiring (48 h default), delivered through an approved
// channel. Crucially, an invitation names ONE practice — joining a known
// email domain must never enrol a user in both.
model Invitation {
  id         String       @id @default(uuid())
  email      String
  practiceId String
  role       PracticeRole

  tokenHash String   @unique
  expiresAt DateTime
  channel   String

  invitedByUserId String?
  invitedByName   String
  sponsorUserId   String?

  acceptedAt      DateTime?
  acceptedByUserId String?
  revokedAt       DateTime?

  createdAt DateTime @default(now())

  @@index([email, acceptedAt])
  @@index([practiceId])
}

enum RecoveryKind {
  PASSWORD_RESET
  MFA_RESET
}

/// AUTH02: "Recovery is verified, logged and cannot silently remove MFA."
/// An MFA reset therefore requires a named substitute approver — this is the
/// documented process for when the owner is absent — and re-enrolment is
/// forced rather than MFA simply being switched off.
model RecoveryRequest {
  id     String       @id @default(uuid())
  userId String
  user   User         @relation(fields: [userId], references: [id])
  kind   RecoveryKind

  tokenHash String   @unique
  expiresAt DateTime
  reason    String

  requestedByName String

  // The absent-owner path: a second, entitled person authorises it.
  approverUserId String?
  approverName   String?
  approvedAt     DateTime?

  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, kind])
}

/// AUTH05 — DSC custody register.
///
/// This table deliberately contains NO private key and NO token PIN. It
/// records who holds which physical token and when, nothing that could be
/// used to sign. A custody record does not authorise signing: the entitled
/// person signs through a separately approved flow.
model DscCustodyRecord {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  ownerName             String
  certificateIdentifier String
  issuedOn              DateTime @db.Date
  expiresOn             DateTime @db.Date

  custodianUserId String?
  custodianName   String
  issuedToCustodianAt DateTime?
  returnedAt          DateTime?

  purpose String
  notes   String?

  archivedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([id, practiceId])
  @@index([practiceId, expiresOn])
}

// AUTH03: "Rate limit login and invitation attempts."
model RateLimitCounter {
  id          String   @id @default(uuid())
  key         String   @unique
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

enum QueuedJobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

// IAM05/IAM01: a queued export outlives the session that requested it, so it
// is both cancellable on revocation AND re-checked by the worker at execution
// time. Either defence alone leaks: cancelling races with a job already
// running, and re-checking alone leaves a revoked user's export sitting in the
// queue.
model QueuedJob {
  id         String  @id @default(uuid())
  practiceId String

  requestedByUserId String
  requestedBy       User   @relation(fields: [requestedByUserId], references: [id])

  kind    String
  payload Json
  state   QueuedJobState @default(QUEUED)

  cancelledReason String?
  failureReason   String?

  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([state, createdAt])
  @@index([requestedByUserId, state])
}

// IAM04: the disclosed exception for a genuine sole-reviewer situation. It is
// recorded, not silent, and always leaves a quality-review obligation behind.
// Legal prohibitions cannot be overridden this way.
model SelfReviewException {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  subjectType    ApprovalSubjectType
  subjectId      String
  subjectVersion Int

  reason            String
  disclosedByUserId String?
  disclosedByName   String

  qualityReviewRequired Boolean   @default(true)
  qualityReviewedAt     DateTime?
  qualityReviewedByName String?

  createdAt DateTime @default(now())

  @@index([practiceId, subjectType, subjectId])
}

// DAT02: role assignment is an interval, not a mutable field.
model PracticeMembership {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  role            PracticeRole
  assignmentScope AssignmentScope @default(OWN_WORK)
  branchId String?
  branch   Branch?      @relation(fields: [branchId, practiceId], references: [id, practiceId])
  teamId   String?
  team     Team?        @relation(fields: [teamId, practiceId], references: [id, practiceId])

  permissionGrants PermissionGrant[]

  effectiveFrom  DateTime
  effectiveTo    DateTime?
  grantExpiresAt DateTime?
  revokedAt      DateTime?

  @@unique([id, practiceId])
  @@unique([practiceId, userId, role, effectiveFrom])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Party / client relationship
// ---------------------------------------------------------------------------

enum PartyType {
  INDIVIDUAL
  HUF
  PARTNERSHIP
  LLP
  COMPANY
  TRUST
  AOP_BOI
  SOCIETY
  GOVERNMENT
}

enum IdentifierKind {
  PAN
  GSTIN
  CIN
  LLPIN
  TAN
  DIN
  AADHAAR_LAST4
}

enum AcceptanceStatus {
  PROSPECT
  ACCEPTED
  DECLINED
  TERMINATED
}

enum ConfidentialityClass {
  NORMAL
  RESTRICTED
  HIGHLY_RESTRICTED
}

enum ContactAuthorityLevel {
  VIEW_ONLY
  UPLOAD
  APPROVE
  SIGNATORY
}

// The legal person. Held at tenant level: the same company may be a client
// of both practices, but each practice's RELATIONSHIP with it is separate.
model Party {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  legalName String
  type      PartyType
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  identifiers   PartyIdentifier[]
  contacts      Contact[]
  relationships ClientRelationship[]
  groupParentOf PartyGroupLink[]     @relation("GroupParent")
  groupChildOf  PartyGroupLink[]     @relation("GroupChild")

  @@index([tenantId, legalName])
}

// CLI03: "Imported PAN, GSTIN, bank details and email addresses remain
// unverified until checked. Validation of format is not proof of identity or
// registration status." Hence a status AND a source on every critical field —
// a well-formed GSTIN is not a verified one.
enum VerificationStatus {
  UNVERIFIED
  FORMAT_CHECKED
  PENDING_VERIFICATION
  VERIFIED
  FAILED_VERIFICATION
}

enum FieldSource {
  MANUAL_ENTRY
  BULK_IMPORT
  PORTAL_UPLOAD
  CLIENT_DECLARATION
  GOVERNMENT_PORTAL
  DOCUMENT_EXTRACTION
}

model PartyIdentifier {
  id      String         @id @default(uuid())
  partyId String
  party   Party          @relation(fields: [partyId], references: [id])
  kind    IdentifierKind
  value   String

  // A party may hold several GST registrations (one per state) without being
  // duplicated as a party — CLI01.
  stateCode String?
  label     String?

  verificationStatus VerificationStatus @default(UNVERIFIED)
  source             FieldSource        @default(MANUAL_ENTRY)
  sourceEvidence     String?

  verifiedAt    DateTime?
  verifiedBy    String?
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  archivedAt    DateTime?

  @@unique([partyId, kind, value, effectiveFrom])
  @@index([kind, value])
}

// CLI01 group links / CLI06: "client groups are navigational links, not
// automatic access grants." Nothing in the scope guard consults this table.
model PartyGroupLink {
  id       String @id @default(uuid())
  tenantId String

  parentPartyId String
  parentParty   Party  @relation("GroupParent", fields: [parentPartyId], references: [id])
  childPartyId  String
  childParty    Party  @relation("GroupChild", fields: [childPartyId], references: [id])

  relationshipType String
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  archivedAt       DateTime?

  @@unique([parentPartyId, childPartyId, relationshipType])
  @@index([tenantId])
}

model Contact {
  id       String  @id @default(uuid())
  partyId  String
  party    Party   @relation(fields: [partyId], references: [id])
  fullName String
  email    String?
  phone    String?
  designation String?

  // CLI01 "verified communication channels" — a channel is not trusted for
  // sending statutory correspondence until it has been checked.
  emailVerificationStatus VerificationStatus @default(UNVERIFIED)
  phoneVerificationStatus VerificationStatus @default(UNVERIFIED)
  source                  FieldSource        @default(MANUAL_ENTRY)

  archivedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorities       ContactAuthority[]
  changeRequests    ContactChangeRequest[]
  releaseRecipients DocumentReleaseRecipient[]

  portalInvitations PortalInvitation[]
  portalSessions    PortalSession[]
  portalUploads     PortalUpload[]
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Acceptance evidence: "Reject an unauthorised email change; retain source
/// evidence."
///
/// A contact's email is how statutory correspondence and portal access reach
/// the client, so changing it is an attack worth staging. Changes therefore
/// go through an authority check and are recorded either way — a REJECTED
/// request is kept, with its evidence, precisely because the attempt matters.
model ContactChangeRequest {
  id         String   @id @default(uuid())
  practiceId String
  contactId  String
  contact    Contact  @relation(fields: [contactId], references: [id])

  field    String
  oldValue String?
  newValue String

  requestedByUserId    String?
  requestedByContactId String?
  requestedByName      String
  source               FieldSource
  sourceEvidence       String?

  status          ChangeRequestStatus @default(PENDING)
  decidedByUserId String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionReason  String?

  createdAt DateTime @default(now())

  @@index([practiceId, status])
  @@index([contactId, createdAt])
}

enum AcceptanceDecision {
  PENDING
  ACCEPTED
  DECLINED
}

/// CLI04 — acceptance and conflict check.
///
/// Recorded BEFORE an engagement can become active. The conflict screen looks
/// across both practices, but `conflictSummary` is written to be non-revealing:
/// it says a related matter exists, not whose it is.
model AcceptanceCheck {
  id                   String             @id @default(uuid())
  practiceId           String
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])

  scope                   String
  competenceAssessment    String
  resourcesAssessment     String
  ethicalThreats          String
  independenceAssessment  String?
  predecessorCommunication String?
  clientAuthority         String

  // Counts and flags only — never the other practice's client names.
  conflictSummary Json

  decision        AcceptanceDecision @default(PENDING)
  partnerUserId   String?
  partnerName     String?
  decidedAt       DateTime?
  decisionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId, decision])
}

/// CLI03 — "Collect only fields needed for the selected service. Save
/// incomplete drafts."
model IntakeDraft {
  id         String @id @default(uuid())
  practiceId String

  serviceCode String
  payload     Json
  missingFields String[]

  createdByUserId String
  submittedAt     DateTime?
  discardedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId, createdByUserId])
}

// One practice's relationship with one party. This is the record every
// practice-scoped professional artefact hangs off.
model ClientRelationship {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  partyId    String
  party      Party    @relation(fields: [partyId], references: [id])

  acceptanceStatus AcceptanceStatus     @default(PROSPECT)
  confidentiality  ConfidentialityClass @default(NORMAL)
  acceptedAt       DateTime?
  terminatedAt     DateTime?
  archivedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  contactAuthorities ContactAuthority[]
  acceptanceChecks   AcceptanceCheck[]
  clientRequests     ClientRequest[]
  messageThreads     MessageThread[]
  engagements        Engagement[]
  obligations        Obligation[]
  documents          Document[]
  documentIntakes    DocumentIntake[]
  invoices           Invoice[]
  receipts           Receipt[]
  portalUploads      PortalUpload[]

  // The composite key every practice-scoped child FKs against.
  feeArrangements FeeArrangement[]

  @@unique([id, practiceId])
  @@unique([practiceId, partyId])
}

// DAT02: authority is an interval — revoking does not erase that the contact
// once held it when an old approval was given.
model ContactAuthority {
  id                   String             @id @default(uuid())
  practiceId           String
  contactId            String
  contact              Contact            @relation(fields: [contactId], references: [id])
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])

  authority     ContactAuthorityLevel
  effectiveFrom DateTime
  effectiveTo   DateTime?
  revokedAt     DateTime?

  @@unique([clientRelationshipId, contactId, authority, effectiveFrom])
  @@index([practiceId])
}

// ---------------------------------------------------------------------------
// Engagement / job / task
// ---------------------------------------------------------------------------

enum EngagementState {
  DRAFT
  PENDING_ACCEPTANCE
  ACCEPTED
  ACTIVE
  CLOSED
  TERMINATED
}

// WRK02. Service templates may hide states they do not use, but the
// underlying approval and evidence rules still apply to every one of them.
enum WorkState {
  DRAFT
  READY
  IN_PROGRESS
  WAITING_FOR_CLIENT
  WAITING_INTERNALLY
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED_FOR_ACTION
  SUBMITTED_DELIVERED
  COMPLETED
  CANCELLED
  REOPENED
}

enum WorkSubjectType {
  JOB
  TASK
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EngagementKind {
  ANNUAL_RETAINER
  AD_HOC
}

enum ClosureKind {
  COMPLETION
  WITHDRAWAL
  CANCELLATION
  NOT_APPLICABLE
}

model Engagement {
  id                   String             @id @default(uuid())
  practiceId           String
  practice             Practice           @relation(fields: [practiceId], references: [id])
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])

  serviceCode     String
  templateVersion String
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date

  // ENG02 required particulars.
  kind             EngagementKind @default(AD_HOC)
  scope            String?
  exclusions       String?
  feeBasis         String?
  billingEntityRegistrationId String?
  plannedStartDate DateTime? @db.Date
  plannedEndDate   DateTime? @db.Date

  // ENG04: a post-acceptance change creates a REVISION. The original is kept
  // and pointed at, never edited — "Preserve the original."
  parentEngagementId String?
  parent             Engagement?  @relation("EngagementRevision", fields: [parentEngagementId], references: [id])
  revisions          Engagement[] @relation("EngagementRevision")
  revisionNumber     Int          @default(0)
  supersededAt       DateTime?

  // ENG06.
  closureKind            ClosureKind?
  closureReason          String?
  closureAuthorisedByName String?

  ownerUserId    String?
  reviewerUserId String?
  state          EngagementState @default(DRAFT)

  // API02 optimistic concurrency — bumped on every mutation.
  version Int @default(0)

  // DAT02: particulars frozen at acceptance. Later master-data edits do not
  // rewrite what was accepted.
  acceptedSnapshot Json?
  acceptedAt       DateTime?

  closedAt   DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  jobs        Job[]
  obligations Obligation[]
  documents   Document[]
  documentIntakes DocumentIntake[]
  invoices    Invoice[]
  letters     EngagementLetter[]
  changes     EngagementChange[]
  blocks      EngagementBlock[]
  messageThreads MessageThread[]
  feeArrangements FeeArrangement[]
  erasureRequests ErasureRequest[]

  @@unique([id, practiceId])
  @@index([practiceId, state])
}

// ---------------------------------------------------------------------------
// Service catalogue and engagement lifecycle (T08, PRD §12)
// ---------------------------------------------------------------------------

/// ENG01 — versioned service templates. A template version is PINNED onto an
/// engagement at creation, so revising the catalogue never rewrites the terms
/// work was accepted under (DAT02).
model ServiceTemplate {
  id       String @id @default(uuid())
  tenantId String

  code     String
  version  Int
  name     String
  category String

  applicabilityInputs Json
  documentChecklist   Json
  steps               Json
  roles               Json
  reviewGates         Json
  deliverables        Json
  feeModel            Json

  effectiveFrom  DateTime  @db.Date
  effectiveTo    DateTime? @db.Date
  approvedByName String?
  archivedAt     DateTime?

  createdAt DateTime @default(now())

  @@unique([tenantId, code, version])
  @@index([tenantId, code])
}

enum LetterReviewState {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT
}

/// ENG03: "Typed consent, electronic acceptance and legally effective
/// signature are distinct records." They are NOT interchangeable — a typed
/// name in a web form is not a signature, and recording them as one field is
/// how that distinction gets lost.
enum AcceptanceKind {
  TYPED_CONSENT
  ELECTRONIC_ACCEPTANCE
  LEGALLY_EFFECTIVE_SIGNATURE
}

model EngagementLetter {
  id           String     @id @default(uuid())
  practiceId   String
  engagementId String
  engagement   Engagement @relation(fields: [engagementId, practiceId], references: [id, practiceId])

  templateCode    String
  templateVersion Int

  /// The letter as generated, frozen. Populated only from verified facts.
  bodySnapshot Json
  bodyHash     String

  reviewState      LetterReviewState @default(DRAFT)
  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?

  sentAt      DateTime?
  sentVersion Int?

  acceptanceKind     AcceptanceKind?
  acceptedAt         DateTime?
  signatoryName      String?
  signatoryCapacity  String?
  acceptanceEvidence Json?

  createdAt DateTime @default(now())

  @@unique([id, practiceId])
  @@index([practiceId, engagementId])
}

enum EngagementChangeType {
  SCOPE
  FEE
  PERIOD
  PRACTICE
}

enum ChangeStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// ENG04 — change control. Recorded against the ORIGINAL engagement, with the
/// reviews the change triggers made explicit rather than left to judgement.
model EngagementChange {
  id           String     @id @default(uuid())
  practiceId   String
  engagementId String
  engagement   Engagement @relation(fields: [engagementId, practiceId], references: [id, practiceId])

  changeType     EngagementChangeType
  reason         String
  beforeSnapshot Json
  afterSnapshot  Json

  /// A scope or fee change re-opens the fee basis and the authority to act.
  requiresFeeReview       Boolean @default(false)
  requiresAuthorityReview Boolean @default(false)
  /// ENG04: reassigning the responsible legal practice needs documented client
  /// arrangements — "changing a dropdown is insufficient".
  requiresClientArrangements Boolean @default(false)
  clientArrangementsEvidence String?

  resultingEngagementId String?

  status            ChangeStatus @default(PENDING_REVIEW)
  requestedByUserId String?
  requestedByName   String
  approvedByUserId  String?
  approvedByName    String?
  approvedAt        DateTime?

  createdAt DateTime @default(now())

  @@index([practiceId, engagementId])
}

enum BlockKind {
  INDEPENDENCE
  ACCEPTANCE
  FEE_APPROVAL
  AUTHORITY
}

/// Activation gate. An engagement with an unresolved block cannot become
/// ACTIVE. Independence blocks additionally require an ELIGIBLE reviewer —
/// the engagement owner cannot clear their own independence question.
model EngagementBlock {
  id           String     @id @default(uuid())
  practiceId   String
  engagementId String
  engagement   Engagement @relation(fields: [engagementId, practiceId], references: [id, practiceId])

  kind         BlockKind
  reason       String
  raisedByName String
  raisedAt     DateTime  @default(now())

  resolvedByUserId String?
  resolvedByName   String?
  resolvedAt       DateTime?
  resolution       String?

  @@index([practiceId, engagementId, resolvedAt])
}

model Job {
  id           String     @id @default(uuid())
  practiceId   String
  practice     Practice   @relation(fields: [practiceId], references: [id])
  engagementId String
  engagement   Engagement @relation(fields: [engagementId, practiceId], references: [id, practiceId])

  title    String
  periodKey String

  /// WRK03 duplicate-prevention identity: practice + client relationship +
  /// stable template/obligation identity + period. The template VERSION is
  /// deliberately NOT part of this — see templateVersionSnapshot below.
  dedupKey String

  /// WRK03: "Store template version as snapshot metadata, not as the
  /// duplicate prevention identity." If the version were part of the key,
  /// editing a template would silently regenerate every open job.
  templateVersionSnapshot Json?

  obligationId String?

  state   WorkState @default(READY)
  version Int      @default(0)

  priority        Priority @default(NORMAL)
  estimateMinutes Int?
  tags            String[]

  ownerUserId    String?
  reviewerUserId String?
  dueDate        DateTime? @db.Date

  completedAt DateTime?
  reopenCount Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tasks          Task[]
  clientRequests ClientRequest[]
  timeEntries    TimeEntry[]
  messageThreads MessageThread[]

  @@unique([id, practiceId])
  @@unique([practiceId, dedupKey])
  @@index([practiceId, state])
}

model Task {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  jobId      String
  job        Job      @relation(fields: [jobId, practiceId], references: [id, practiceId])

  title       String
  state       WorkState @default(READY)
  version     Int       @default(0)
  assigneeUserId String?
  reviewerUserId String?
  priority       Priority @default(NORMAL)
  estimateMinutes Int?
  tags           String[]
  dueDate     DateTime? @db.Date

  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  checklistItems ChecklistItem[]
  blockedBy      TaskDependency[] @relation("BlockedTask")
  blocks         TaskDependency[] @relation("BlockingTask")

  @@unique([id, practiceId])
  @@index([practiceId, state])
}

model ChecklistItem {
  id         String   @id @default(uuid())
  practiceId String
  taskId     String
  task       Task     @relation(fields: [taskId, practiceId], references: [id, practiceId])

  label       String
  isComplete  Boolean  @default(false)
  completedAt DateTime?
  completedByUserId String?
  sortOrder   Int      @default(0)

  /// WRK01: "Required steps can be completed only by the authorised role;
  /// optional steps record Not applicable with reason."
  isRequired         Boolean       @default(true)
  requiredRole       PracticeRole?
  notApplicable      Boolean       @default(false)
  notApplicableReason String?

  @@index([practiceId])
}

model TaskDependency {
  id         String @id @default(uuid())
  practiceId String

  taskId String
  task   Task   @relation("BlockedTask", fields: [taskId, practiceId], references: [id, practiceId])

  dependsOnTaskId String
  dependsOnTask   Task   @relation("BlockingTask", fields: [dependsOnTaskId, practiceId], references: [id, practiceId])

  /// WRK04: a dependency may also be on EVIDENCE rather than another task —
  /// e.g. the signed management representation letter must exist before the
  /// audit report can be released.
  requiredEvidenceLabel String?
  evidenceDocumentId    String?

  @@unique([taskId, dependsOnTaskId])
  @@index([practiceId])
}

/// WRK02 + the reopen requirement.
///
/// "Reopen a completed job without changing its original filing evidence or
///  deleting its completion history."
///
/// Completion history therefore lives here, not in a mutable field on the job.
/// Reopening appends a transition; it never erases the earlier COMPLETED one.
model WorkStateTransition {
  id         String          @id @default(uuid())
  practiceId String
  subjectType WorkSubjectType
  subjectId   String

  fromState WorkState
  toState   WorkState

  actorUserId String?
  actorName   String
  reason      String?

  /// The subject's version at the moment of transition, so an approval can be
  /// tied to exactly what was approved (API02).
  subjectVersion Int

  createdAt DateTime @default(now())

  @@index([practiceId, subjectType, subjectId, createdAt])
}

enum ClientRequestState {
  OPEN
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

/// WRK01 keeps Client Request separate from Task deliberately: an outstanding
/// item owed BY the client is not a piece of internal work, and conflating
/// them is how "waiting for the client" becomes invisible.
model ClientRequest {
  id                   String             @id @default(uuid())
  practiceId           String
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])

  engagementId String?
  jobId        String?
  job          Job?    @relation(fields: [jobId, practiceId], references: [id, practiceId])

  title          String
  detail         String?
  requestedItems Json

  /// COM02: whether an item's reminder stops when a file ARRIVES or only once
  /// staff have accepted it. Configured per request, because "we have it" and
  /// "it is usable" are different claims and the difference matters at a
  /// statutory deadline.
  closeRule RequestCloseRule @default(ON_ACCEPTANCE)

  state    ClientRequestState @default(OPEN)
  dueDate  DateTime?          @db.Date
  sentAt   DateTime?
  receivedAt DateTime?
  closedAt DateTime?

  /// WRK04: a client delay pauses the INTERNAL response clock only, under the
  /// defined SLA. It never moves the statutory deadline — that stays on the
  /// Obligation, untouched.
  slaPausedAt      DateTime?
  slaPausedTotalMs Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ClientRequestItem[]

  @@unique([id, practiceId])
  @@index([practiceId, state])
  @@index([practiceId, dueDate])
}

/// The R0 sliver of time tracking needed by WRK05 — a reassignment must
/// account for a timer left running. Full time and capacity reporting is R1.
model TimeEntry {
  id         String @id @default(uuid())
  practiceId String

  jobId  String?
  job    Job?    @relation(fields: [jobId, practiceId], references: [id, practiceId])
  taskId String?

  userId    String
  startedAt DateTime  @default(now())
  stoppedAt DateTime?
  minutes   Int?
  note      String?

  @@index([practiceId, userId, stoppedAt])
}

/// WRK05: "Reassign with reason and notification; include active timers and
/// pending approvals. Employee exit generates a handover list, not orphaned
/// jobs."
model WorkReassignment {
  id          String          @id @default(uuid())
  practiceId  String
  subjectType WorkSubjectType
  subjectId   String

  fromUserId String?
  toUserId   String
  reason     String

  actorUserId String?
  actorName   String

  /// Carried across explicitly rather than left dangling under the old owner.
  activeTimerIds        String[]
  pendingApprovalsCount Int      @default(0)
  notifiedAt            DateTime?

  createdAt DateTime @default(now())

  @@index([practiceId, subjectType, subjectId])
  @@index([practiceId, toUserId])
}

// ---------------------------------------------------------------------------
// Obligation / rule
// ---------------------------------------------------------------------------

// DUE04 status set. REVIEW_REQUIRED comes from DUE02: "Store Unknown
// applicability as a review state, not as Not applicable" — the two must never
// be conflated, because "not applicable" silently removes a deadline that may
// in fact apply.
enum ObligationStatus {
  REVIEW_REQUIRED
  OPEN
  DUE_SOON
  OVERDUE
  WAITING
  SUBMITTED_AWAITING_ACK
  FILED
  REJECTED
  NOT_APPLICABLE
  CANCELLED
}

// DUE01 rule lifecycle.
enum RuleStatus {
  DRAFT
  REVIEWED
  ACTIVE
  SUPERSEDED
  RETIRED
}

/// The PRD's closing note for §14: "Preserve both income tax regimes:
/// FY 2025-26 / AY 2026-27 uses the 1961 Act; Tax Year 2026-27 uses the 2025
/// Act. Filing date alone must not choose the Act. Store law, assessment year
/// and tax year independently."
enum GoverningLaw {
  INCOME_TAX_ACT_1961
  INCOME_TAX_ACT_2025
  CGST_ACT_2017
  COMPANIES_ACT_2013
  LLP_ACT_2008
  OTHER
}

enum TaxpayerCategory {
  INDIVIDUAL
  HUF
  FIRM
  LLP
  COMPANY_PRIVATE
  COMPANY_PUBLIC
  TRUST
  AOP_BOI
  COOPERATIVE
  AUDIT_CASE
  NON_AUDIT_CASE
  TRANSFER_PRICING_CASE
}

enum AlertKindDue {
  DUE_SOON
  OVERDUE
  ESCALATION
  CATCH_UP
}

enum DeliveryState {
  PENDING
  SENT
  DELIVERED
  BOUNCED
  FAILED
}

// Tenant-wide statutory rule, versioned. DAT02: a new statutory position is
// a new version, never an edit of the version old work was done under.
model ObligationRule {
  id      String @id @default(uuid())
  code    String
  version Int
  source  String

  // DUE01 particulars.
  jurisdiction     String           @default("IN")
  governingLaw     GoverningLaw     @default(OTHER)
  service          String?
  taxpayerCategory TaxpayerCategory?
  relevantPeriod   String?
  formVersion      String?

  /// How the statutory date is derived, e.g. "20th of the month following the
  /// period". Held as an expression so the derivation is auditable rather than
  /// a bare date someone typed.
  dueDateExpression String?

  authoritativeSource String?
  sourceDate          DateTime? @db.Date
  approvingCaName     String?

  // Taxpayer-class criteria an extension or applicability test matches on.
  applicability Json

  status RuleStatus @default(DRAFT)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt @default(now())

  obligations Obligation[]

  @@unique([code, version])
  @@index([status, jurisdiction])
}

model Obligation {
  id                   String             @id @default(uuid())
  practiceId           String
  practice             Practice           @relation(fields: [practiceId], references: [id])
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])
  engagementId         String?
  engagement           Engagement?        @relation(fields: [engagementId, practiceId], references: [id, practiceId])

  ruleId      String
  rule        ObligationRule @relation(fields: [ruleId], references: [id])
  ruleVersion Int
  periodKey   String

  // DUE02: "Separate law, internal planning, client submission and payment
  // dates." Collapsing these into one field is how an internal target quietly
  // becomes the date people believe is statutory.
  // DAT01: statutory dates are date-only values, not instants.
  originalStatutoryDate DateTime  @db.Date
  currentStatutoryDate  DateTime  @db.Date
  internalTargetDate    DateTime? @db.Date
  reviewTargetDate      DateTime? @db.Date
  clientDocumentCutoff  DateTime? @db.Date
  paymentDeadline       DateTime? @db.Date

  /// Stored INDEPENDENTLY, per the PRD: the filing date alone must never be
  /// what selects which Act applies. A return filed in 2026 could be under
  /// either the 1961 Act (AY 2026-27) or the 2025 Act (Tax Year 2026-27).
  governingLaw     GoverningLaw?
  assessmentYear   String?
  taxYear          String?
  taxpayerCategory TaxpayerCategory?
  formVersion      String?

  // DUE04: an obligation whose category cannot be determined stays here
  // rather than silently defaulting to a date.
  status  ObligationStatus @default(REVIEW_REQUIRED)
  version Int              @default(0)

  filedAt    DateTime?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  changes        ObligationChange[]
  alerts         ObligationAlert[]
  filingEvidence FilingEvidence[]
  documents      Document[]

  @@unique([id, practiceId])
  @@unique([practiceId, clientRelationshipId, ruleId, periodKey])
  @@index([practiceId, currentStatutoryDate])
}

/// DUE02: "Show the source and reason for each revision." Every movement of a
/// statutory date is recorded with what authorised it — so the audit trail can
/// show BOTH the original and the current date, and where the change came from.
model ObligationChange {
  id           String     @id @default(uuid())
  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id])

  changedByUserId   String?
  changedByName     String
  reason            String
  beforeMeta        Json
  afterMeta         Json
  approvedByUserId  String?

  sourceReference String?
  extensionId     String?
  extension       StatutoryExtension? @relation(fields: [extensionId], references: [id])

  createdAt         DateTime @default(now())

  @@index([obligationId, createdAt])
}

enum ExtensionStatus {
  DRAFT
  PREVIEWED
  APPLIED
  WITHDRAWN
}

/// DUE03 — extensions.
///
/// "An approved notification produces a preview of affected open instances.
///  Apply only to matching category, period and jurisdiction. Preserve old
///  values and linked source. Do not reopen completed filings automatically."
///
/// The matching fields below are nullable and mean "any" when unset, so a
/// notification that applies to one taxpayer class cannot accidentally sweep
/// up everything.
model StatutoryExtension {
  id       String @id @default(uuid())
  tenantId String

  notificationReference String
  authoritativeSource   String?
  sourceDate            DateTime @db.Date

  // Matching criteria.
  jurisdiction     String            @default("IN")
  governingLaw     GoverningLaw?
  ruleCode         String?
  taxpayerCategory TaxpayerCategory?
  periodKey        String?
  formVersion      String?

  originalDate DateTime @db.Date
  extendedDate DateTime @db.Date

  status          ExtensionStatus @default(DRAFT)
  approvedByName  String?
  approvedAt      DateTime?
  previewedAt     DateTime?
  appliedAt       DateTime?
  appliedCount    Int             @default(0)

  createdAt DateTime @default(now())

  changes ObligationChange[]

  @@index([tenantId, status])
}

/// DUE04 — alerts and evidence.
///
/// Delivery state matters as much as the alert itself: "A bounced reminder
/// never becomes evidence of client receipt." Only DELIVERED plus an explicit
/// acknowledgement counts.
model ObligationAlert {
  id           String     @id @default(uuid())
  practiceId   String
  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id])

  kind            AlertKindDue
  escalationLevel Int          @default(0)
  responsibleRole PracticeRole?

  dueAt  DateTime
  sentAt DateTime?

  deliveryState   DeliveryState @default(PENDING)
  deliveryDetail  String?

  acknowledgedAt     DateTime?
  acknowledgedByUserId String?
  acknowledgedByName String?

  /// DUE06: a missed scheduler run must produce catch-up alerts WITHOUT
  /// duplicates, so each alert occurrence has a stable key.
  dedupKey String

  createdAt DateTime @default(now())

  @@unique([dedupKey])
  @@index([practiceId, kind, dueAt])
}

/// DUE04: "Filing completion requires acknowledgement / reference evidence and
/// reviewer confirmation; marking a task Done is insufficient."
model FilingEvidence {
  id           String     @id @default(uuid())
  practiceId   String
  obligationId String
  obligation   Obligation @relation(fields: [obligationId], references: [id])

  acknowledgementReference String
  filedAt                  DateTime
  portalResponse           Json?
  documentVersionId        String?
  sourceFileSha256         String?

  reviewerUserId      String?
  reviewerName        String
  reviewerConfirmedAt DateTime

  createdAt DateTime @default(now())

  @@index([practiceId, obligationId])
}

// ---------------------------------------------------------------------------
// Document / version
// ---------------------------------------------------------------------------

enum DocumentSource {
  STAFF_UPLOAD
  PORTAL_UPLOAD
  EMAIL_INTAKE
  SCAN
  SYSTEM_GENERATED
}

enum ScanVerdict {
  PENDING
  CLEAN
  INFECTED
  UNSUPPORTED_TYPE
  // DOC01: "quarantine suspicious files". Suspicious is not the same as
  // infected — a declared/detected MIME mismatch or a decompression bomb has
  // no virus signature but must never reach the document store either.
  SUSPICIOUS
  // The scanner was unreachable. Fail CLOSED: an unscanned file is withheld,
  // never optimistically admitted.
  SCAN_UNAVAILABLE
}

// DOC04: "Separate internal, client supplied and approved client deliverable
// records." These are different record classes, not a display flag — the
// release path and the retention class both key off this.
enum DocumentKind {
  INTERNAL
  CLIENT_SUPPLIED
  APPROVED_DELIVERABLE
}

enum IntakeOutcome {
  ACCEPTED
  QUARANTINED
  REJECTED
}

// DOC01: "show actionable rejection reasons". A coded reason so the message
// shown to the uploader is stable and translatable, plus free-text detail.
enum RejectionReason {
  NONE
  DISALLOWED_TYPE
  MIME_MISMATCH
  TOO_LARGE
  EMPTY_FILE
  DECOMPRESSION_LIMIT
  ENCRYPTED_ARCHIVE
  // The PRD names this outcome directly: "Quarantine a malformed archive."
  // An archive whose own directory cannot be read is not a clean file that
  // happens to be broken — it is a file whose contents cannot be checked.
  MALFORMED_ARCHIVE
  MALWARE_SIGNATURE
  SCANNER_UNAVAILABLE
}

// DOC02: "Capture preparer, reviewer and status."
enum VersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SUPERSEDED
  WITHDRAWN
}

// DOC02: an OCR pass, a PDF conversion or a redaction produces a NEW
// derivative version. It never rewrites the original it was derived from.
enum DerivationKind {
  ORIGINAL
  OCR
  CONVERSION
  REDACTION
  COMPRESSION
}

enum ClassificationStatus {
  DRAFT
  CONFIRMED
  REJECTED
  CORRECTED
}

enum DocumentSetState {
  OPEN
  FINALISED
}

enum DeletionState {
  REQUESTED
  APPROVED
  REJECTED
  EXECUTED
}

model Document {
  id                   String              @id @default(uuid())
  practiceId           String
  practice             Practice            @relation(fields: [practiceId], references: [id])
  clientRelationshipId String?
  clientRelationship   ClientRelationship? @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])
  engagementId         String?
  engagement           Engagement?         @relation(fields: [engagementId, practiceId], references: [id, practiceId])
  obligationId         String?
  obligation           Obligation?         @relation(fields: [obligationId, practiceId], references: [id, practiceId])

  title          String
  classification ConfidentialityClass @default(NORMAL)

  // DOC04 record class.
  kind DocumentKind @default(INTERNAL)
  // DOC04: "Internal audit working papers are not automatically client
  // deliverables." Held separately from `kind` because a working paper stays
  // a working paper even after a redacted extract is released.
  workingPaper Boolean @default(false)

  // DOC03: classify by document type, period, entity and sensitivity. The
  // entity is `clientRelationshipId`; sensitivity is `classification`.
  documentType String?
  periodLabel  String?
  periodStart  DateTime? @db.Date
  periodEnd    DateTime? @db.Date

  // DOC06 lock and retention.
  documentSetId    String?
  retentionPolicyId String?
  retentionUntil   DateTime? @db.Date
  retentionBasis   String?
  legalHold        Boolean   @default(false)
  lockedAt         DateTime?
  lockedByUserId   String?

  // API02: optimistic concurrency on classification / release state.
  version Int @default(0)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  versions        DocumentVersion[]
  setEntries      DocumentSetEntry[]
  deletionRequests DeletionRequest[]
  documentSet     DocumentSet?       @relation(fields: [documentSetId, practiceId], references: [id, practiceId])

  @@unique([id, practiceId])
  @@index([practiceId, classification])
  @@index([practiceId, kind])
  @@index([practiceId, documentType])
  @@index([practiceId, title])
}

// DAT02: originals are immutable. A re-upload of the same filename creates
// version n+1; it never overwrites version n.
model DocumentVersion {
  id         String   @id @default(uuid())
  practiceId String
  documentId String
  document   Document @relation(fields: [documentId, practiceId], references: [id, practiceId])

  versionNo       Int
  storageObjectId String
  sha256          String
  mimeType        String
  sizeBytes       BigInt
  source          DocumentSource
  scanVerdict     ScanVerdict    @default(PENDING)

  // DOC01 provenance carried onto the stored version.
  filename         String  @default("")
  declaredMimeType String?

  // DOC02 status and custody.
  status            VersionStatus @default(DRAFT)
  preparedByUserId  String?
  reviewedByUserId  String?
  reviewedAt        DateTime?
  approvedByUserId  String?
  approvedByUserName String?
  approvedAt        DateTime?
  supersededAt      DateTime?

  // DOC02 / redaction rule: a derivative names the exact version it came from
  // and how it was produced, so an OCR or redaction pass can never be mistaken
  // for the original evidence.
  derivation            DerivationKind @default(ORIGINAL)
  derivedFromVersionId  String?
  derivedFromVersion    DocumentVersion?  @relation("Derivation", fields: [derivedFromVersionId, practiceId], references: [id, practiceId])
  derivatives           DocumentVersion[] @relation("Derivation")

  createdAt DateTime @default(now())

  releaseGrants   DocumentReleaseGrant[]
  releases        DocumentRelease[]
  accessTokens    DocumentAccessToken[]
  classifications DocumentClassification[]
  setEntries      DocumentSetEntry[]
  redactionReview RedactionReview?

  @@unique([id, practiceId])
  @@unique([documentId, versionNo])
  @@index([practiceId, sha256])
  @@index([practiceId, status])
}

model DocumentReleaseGrant {
  id                String          @id @default(uuid())
  practiceId        String
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId, practiceId], references: [id, practiceId])

  grantedToContactId String?
  grantedToUserId    String?
  grantedByUserId    String?

  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([practiceId, expiresAt])
}

// ---------------------------------------------------------------------------
// DOC01 — intake
// ---------------------------------------------------------------------------

// Every upload ATTEMPT gets a row, including the ones that never became a
// document. A rejected or quarantined file that leaves no record is how a
// malicious upload becomes invisible, and how the uploader is left with no
// actionable reason.
model DocumentIntake {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  // Null while the file is quarantined or rejected — nothing was filed.
  documentId        String?
  documentVersionId String?

  clientRelationshipId String?
  clientRelationship   ClientRelationship? @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])
  engagementId         String?
  engagement           Engagement?         @relation(fields: [engagementId, practiceId], references: [id, practiceId])
  obligationId         String?
  checklistItemId      String?
  clientRequestId      String?
  periodLabel          String?

  filename         String
  declaredMimeType String
  detectedMimeType String?
  sizeBytes        BigInt
  sha256           String?
  source           DocumentSource

  // A portal upload is made by a client CONTACT, not a staff user.
  uploadedByUserId    String?
  uploadedByContactId String?
  receivedAt          DateTime @default(now())

  outcome         IntakeOutcome
  rejectionReason RejectionReason @default(NONE)
  rejectionDetail String?

  scanVerdict    ScanVerdict @default(PENDING)
  scannerName    String?
  scannerVersion String?

  // Quarantined bytes are held under a separate key prefix, never alongside
  // clean documents, and are not reachable through any document route.
  quarantineObjectId String?

  createdAt DateTime @default(now())

  @@index([practiceId, receivedAt])
  @@index([practiceId, outcome])
}

// ---------------------------------------------------------------------------
// DOC03 — classification metadata
// ---------------------------------------------------------------------------

// "OCR and AI classifications are draft metadata with source references and
// correction history." A suggestion is never silently written onto the
// document — it lands here as DRAFT and a human confirms or corrects it.
model DocumentClassification {
  id                String          @id @default(uuid())
  practiceId        String
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId, practiceId], references: [id, practiceId])

  field      String
  value      String
  confidence Float?

  producedBy      String
  modelVersion    String?
  sourceReference String?

  status           ClassificationStatus @default(DRAFT)
  supersedesId     String?
  supersedes       DocumentClassification?  @relation("ClassificationCorrection", fields: [supersedesId], references: [id])
  correctedBy      DocumentClassification[] @relation("ClassificationCorrection")
  decidedByUserId  String?
  decidedByUserName String?
  decidedAt        DateTime?
  correctionReason String?

  createdAt DateTime @default(now())

  @@index([practiceId, documentVersionId, field])
}

// ---------------------------------------------------------------------------
// DOC04 — release and sharing
// ---------------------------------------------------------------------------

// A release is pinned to ONE version. Releasing "the document" is how a later,
// unreviewed version silently reaches a client.
model DocumentRelease {
  id                String          @id @default(uuid())
  practiceId        String
  documentId        String
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId, practiceId], references: [id, practiceId])

  releasedByUserId   String
  releasedByUserName String
  reason             String?

  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedByUserId String?
  revokeReason   String?

  createdAt DateTime @default(now())

  recipients DocumentReleaseRecipient[]
  tokens     DocumentAccessToken[]

  @@index([practiceId, documentId])
}

// "A reviewer releases an exact version to NAMED portal contacts."
model DocumentReleaseRecipient {
  id         String          @id @default(uuid())
  practiceId String
  releaseId  String
  release    DocumentRelease @relation(fields: [releaseId], references: [id])

  contactId            String
  contact              Contact @relation(fields: [contactId], references: [id])
  clientRelationshipId String
  // DAT02: the name at the moment of release, so a later rename cannot
  // rewrite who a report was sent to.
  contactNameAtRelease String

  @@unique([releaseId, contactId])
  @@index([practiceId, contactId])
}

// The link handed out is a token for THIS row, not a presigned object-store
// URL. A presigned URL is valid until it expires no matter what happens to the
// holder's access, which is exactly what DOC04's "revoke on permission change"
// forbids. Redemption re-authorises against live state every time.
model DocumentAccessToken {
  id                String          @id @default(uuid())
  practiceId        String
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId, practiceId], references: [id, practiceId])
  releaseId         String?
  release           DocumentRelease? @relation(fields: [releaseId], references: [id])

  tokenHash String @unique

  issuedToUserId    String?
  issuedToContactId String?
  issuedByUserId    String?
  purpose           String

  expiresAt   DateTime
  revokedAt   DateTime?
  revokeReason String?
  maxUses     Int?
  usedCount   Int       @default(0)
  lastUsedAt  DateTime?

  createdAt DateTime @default(now())

  @@index([practiceId, expiresAt])
  @@index([issuedToUserId])
}

// The section's closing rule: "Redaction produces a derivative with a review
// record; visual black rectangles alone do not prove sensitive content has
// been removed." The reviewer must record that the hidden layers were checked.
model RedactionReview {
  id                String          @id @default(uuid())
  practiceId        String
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId, practiceId], references: [id, practiceId])

  sourceVersionId String
  method          String

  checkedHiddenText  Boolean @default(false)
  checkedMetadata    Boolean @default(false)
  checkedAttachments Boolean @default(false)
  checkedOcrLayer    Boolean @default(false)

  reviewedByUserId   String
  reviewedByUserName String
  conclusion         String
  reviewedAt         DateTime @default(now())

  @@unique([documentVersionId, practiceId])
  @@index([practiceId])
}

// ---------------------------------------------------------------------------
// DOC06 — lock, retention and deletion
// ---------------------------------------------------------------------------

model DocumentSet {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  engagementId         String?
  clientRelationshipId String?
  name                 String
  state                DocumentSetState @default(OPEN)

  // The manifest is the evidence: version ids, numbers and hashes at the
  // moment of finalisation, plus a hash OF the manifest so the list itself is
  // tamper-evident.
  manifest         Json?
  manifestSha256   String?
  finalisedAt      DateTime?
  finalisedByUserId String?
  finalisedByUserName String?

  createdAt DateTime @default(now())

  entries   DocumentSetEntry[]
  documents Document[]

  @@unique([id, practiceId])
  @@index([practiceId, state])
}

model DocumentSetEntry {
  id            String      @id @default(uuid())
  practiceId    String
  documentSetId String
  documentSet   DocumentSet @relation(fields: [documentSetId, practiceId], references: [id, practiceId])

  documentId        String
  document          Document        @relation(fields: [documentId, practiceId], references: [id, practiceId])
  documentVersionId String
  documentVersion   DocumentVersion @relation(fields: [documentVersionId, practiceId], references: [id, practiceId])

  versionNo Int
  sha256    String
  addedAt   DateTime @default(now())

  @@unique([documentSetId, documentVersionId])
  @@index([practiceId])
}

model RetentionPolicy {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  recordClass   String
  retainYears   Int
  basis         String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  // PRV06 (T19). A schedule is keyed by record class, governing rule, trigger
  // and hold. Two kinds of rule, deliberately not one number:
  //  RETAIN_AT_LEAST — a floor (a statute says keep it this long). A floor is
  //    never a purge timer: reaching it makes deletion ALLOWED, not due.
  //  DELETE_AFTER    — a ceiling (e.g. a data-minimisation rule, once it is
  //    operative). A ceiling can never cut below a longer floor or a hold.
  direction RetentionDirection @default(RETAIN_AT_LEAST)
  trigger   RetentionTrigger   @default(CREATED)
  // Periods shorter than a year (CERT-In's rolling 180 days) are in days; when
  // set, retainDays wins over retainYears.
  retainDays Int?
  // What the schedule reaches. BACKUP is listed so a schedule says out loud
  // whether backups follow it — silence there is how deleted data lingers.
  covers RetentionCoverage[] @default([ORIGINAL, DERIVATIVE])
  // PRV02 link: a rule that exists only because of a regulatory requirement
  // applies only while that requirement is OPERATIONAL.
  regulatoryRequirementId String?

  createdByUserId String?
  createdAt DateTime @default(now())

  @@unique([practiceId, recordClass, direction, basis, effectiveFrom])
  @@index([practiceId, recordClass])
}

enum RetentionDirection {
  RETAIN_AT_LEAST
  DELETE_AFTER
}

enum RetentionTrigger {
  CREATED
  ENGAGEMENT_CLOSED
  FINANCIAL_YEAR_END
  RELATIONSHIP_ENDED
  LAST_ACTIVITY
}

enum RetentionCoverage {
  ORIGINAL
  DERIVATIVE
  EMAIL
  AI_OUTPUT
  ICT_LOG
  BACKUP
}

model LegalHold {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  reason             String
  scopeDocumentId    String?
  scopeEngagementId  String?
  scopeClientRelationshipId String?

  placedByUserId   String
  placedByUserName String
  placedAt         DateTime  @default(now())
  releasedAt       DateTime?
  releasedByUserId String?
  releaseReason    String?

  @@index([practiceId, releasedAt])
}

// DOC06: "Deletion requires eligibility check, approval and logged action."
// Three separate gates, each recorded — a delete button that checks all three
// inline leaves nothing to inspect afterwards.
model DeletionRequest {
  id         String   @id @default(uuid())
  practiceId String
  documentId String
  document   Document @relation(fields: [documentId, practiceId], references: [id, practiceId])

  requestedByUserId String
  requestedAt       DateTime @default(now())
  reason            String

  eligibilityCheckedAt DateTime?
  eligible             Boolean?
  ineligibleReason     String?

  state              DeletionState @default(REQUESTED)
  approvedByUserId   String?
  approvedByUserName String?
  approvedAt         DateTime?
  rejectedReason     String?
  executedAt         DateTime?

  // Retained backups follow their own documented expiry — deleting the live
  // record does not reach into them, and saying so is part of the record.
  backupExpiryNote String?

  @@index([practiceId, state])
}

// ---------------------------------------------------------------------------
// Invoice / receipt
// ---------------------------------------------------------------------------

// FIN02 names seven states, and they are not interchangeable. DRAFT and
// APPROVED are editable; ISSUED onward are not. PART_PAID, PAID and CREDITED
// are DERIVED from allocations (see src/lib/receipts.ts) and never typed by
// hand — a status somebody can set directly is a status that will disagree
// with the money.
enum InvoiceStatus {
  DRAFT
  APPROVED
  ISSUED
  PART_PAID
  PAID
  CREDITED
  CANCELLED
}

// FIN04: "Separate cash received from tax deducted and credit notes." Each of
// these settles an invoice for a different reason, and netting them into one
// figure is exactly what the requirement forbids — TDS is a tax credit the
// client claims, not cash the practice banked.
enum AllocationKind {
  PAYMENT
  TDS
  WRITE_OFF
  ADVANCE
  REFUND
  CREDIT_NOTE
}

// FIN02: a credit note carries its own numbering, so a correction is never
// issued as an invoice number and the invoice series stays gapless.
enum SeriesKind {
  INVOICE
  CREDIT_NOTE
}

// FIN01 fee bases. TIME_BASED still requires an agreed rate on the
// arrangement — "never infer rates from a staff timer alone."
enum FeeBasis {
  FIXED
  RECURRING
  MILESTONE
  TIME_BASED
}

enum FeeArrangementStatus {
  DRAFT
  APPROVED
  SUPERSEDED
  WITHDRAWN
}

// FIN01 charge types that are not the headline fee.
enum FeeComponentKind {
  MILESTONE
  REIMBURSABLE_EXPENSE
  ADVANCE
  SCOPE_CHANGE
}

enum CreditNoteStatus {
  DRAFT
  APPROVED
  ISSUED
  CANCELLED
}

// FIN02: each practice owns its own series. Two practices may both issue
// number 1 — they are different series, so there is no collision.
model InvoiceSeries {
  id             String                @id @default(uuid())
  practiceId     String
  practice       Practice              @relation(fields: [practiceId], references: [id])
  registrationId String?
  registration   PracticeRegistration? @relation(fields: [registrationId, practiceId], references: [id, practiceId])

  kind         SeriesKind @default(INVOICE)
  code         String
  fiscalPeriod String
  nextNumber   Int      @default(1)

  /// FIN02 "approved numbering policy": once locked, the shape of the number
  /// is fixed for the series. Nothing here regenerates past numbers.
  numberFormat String?
  lockedAt     DateTime?
  archivedAt   DateTime?

  invoices    Invoice[]
  creditNotes CreditNote[]

  @@unique([id, practiceId])
  @@unique([practiceId, code, fiscalPeriod])
}

model Invoice {
  id                   String             @id @default(uuid())
  practiceId           String
  practice             Practice           @relation(fields: [practiceId], references: [id])
  seriesId             String
  series               InvoiceSeries      @relation(fields: [seriesId, practiceId], references: [id, practiceId])
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])
  engagementId         String?
  engagement           Engagement?        @relation(fields: [engagementId, practiceId], references: [id, practiceId])

  feeArrangementId String?
  feeArrangement   FeeArrangement? @relation(fields: [feeArrangementId, practiceId], references: [id, practiceId])

  /// NULL until issue. FIN02 numbers an invoice when it is ISSUED, and a
  /// draft genuinely has no number — writing a placeholder 0 instead made
  /// @@unique([seriesId, sequenceNumber]) allow only ONE draft per series.
  /// Postgres permits many NULLs in a unique index, which is exactly the
  /// shape of the fact: unnumbered drafts do not compete for a number.
  sequenceNumber Int?
  /// The rendered number a client sees ("FA/2025-26/1"). Held alongside the
  /// integer because the policy that produced it can change for LATER series
  /// and an issued number must keep the form it was issued in.
  displayNumber  String?
  currency       String        @default("INR") @db.Char(3)
  taxRuleVersion String?
  status         InvoiceStatus @default(DRAFT)

  issueDate DateTime? @db.Date
  dueDate   DateTime? @db.Date

  // FIN02 approval is separate from issue: approving says the particulars are
  // right, issuing sends it and locks them.
  approvedByUserId String?
  approvedByName   String?
  approvedAt       DateTime?

  subtotal Decimal @default(0) @db.Decimal(18, 2)
  taxTotal Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)

  // DAT02: written once at issue and never updated. Holds the client legal
  // name, contact, addresses, registration numbers and line particulars as
  // they stood at that instant — so renaming a contact later cannot alter
  // an invoice that has already gone out.
  issuedSnapshot Json?
  issuedAt       DateTime?
  cancelledAt    DateTime?

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines       InvoiceLine[]
  allocations ReceiptAllocation[]
  creditNotes CreditNote[]

  @@unique([id, practiceId])
  @@unique([seriesId, sequenceNumber])
  @@index([practiceId, status])
}

model InvoiceLine {
  id         String  @id @default(uuid())
  practiceId String
  invoiceId  String
  invoice    Invoice @relation(fields: [invoiceId, practiceId], references: [id, practiceId])

  description    String
  quantity       Decimal @db.Decimal(18, 4)
  unitAmount     Decimal @db.Decimal(18, 2)
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal @db.Decimal(18, 2)
  sortOrder      Int     @default(0)

  @@index([practiceId])
}

model Receipt {
  id                   String             @id @default(uuid())
  practiceId           String
  practice             Practice           @relation(fields: [practiceId], references: [id])
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])

  /// FIN04 "against the correct bank account". Optional at the DATABASE level
  /// only because rows predating this column exist and inventing a bank
  /// account for them would be worse than recording that none was captured;
  /// `recordReceipt` requires one for everything created from here on.
  bankAccountId String?
  bankAccount   PracticeBankAccount? @relation(fields: [bankAccountId, practiceId], references: [id, practiceId])

  amount     Decimal  @db.Decimal(18, 2)
  currency   String   @default("INR") @db.Char(3)
  receivedAt DateTime
  method     String
  reference  String?

  archivedAt DateTime?
  createdAt  DateTime @default(now())

  allocations ReceiptAllocation[]

  @@unique([id, practiceId])
  @@index([practiceId, receivedAt])
}

// FIN04: a part payment and a TDS deduction against the same invoice are
// distinct allocation rows, not one netted figure.
model ReceiptAllocation {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])
  /// Nullable because a CREDIT_NOTE allocation settles an invoice without any
  /// money arriving. Exactly one of receiptId / creditNoteId is set, and
  /// `allocateReceipt` is the only writer that enforces it.
  receiptId  String?
  receipt    Receipt? @relation(fields: [receiptId, practiceId], references: [id, practiceId])

  creditNoteId String?
  creditNote   CreditNote? @relation(fields: [creditNoteId, practiceId], references: [id, practiceId])

  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId, practiceId], references: [id, practiceId])

  kind      AllocationKind
  amount    Decimal        @db.Decimal(18, 2)
  createdAt DateTime       @default(now())

  // FIN04 "preserve reconciliation adjustments": a wrong allocation is
  // REVERSED by a row that points at it, never deleted and never edited. The
  // balance maths ignores a reversed row and its reversal in equal measure,
  // so both stay visible to whoever has to reconcile.
  reversedAt     DateTime?
  reversalReason String?
  reversalOfId   String?             @unique
  reversalOf     ReceiptAllocation?  @relation("AllocationReversal", fields: [reversalOfId], references: [id])
  reversedBy     ReceiptAllocation?  @relation("AllocationReversal")

  createdByUserId String?

  @@index([practiceId, invoiceId])
}

// ---------------------------------------------------------------------------
// FIN01 fee arrangements
// ---------------------------------------------------------------------------

/// FIN01: what was AGREED, tied to the engagement and the owning practice.
/// A change of scope does not edit this row — it supersedes it with a
/// revision, so the fee that was agreed for work already done stays readable.
model FeeArrangement {
  id                   String             @id @default(uuid())
  practiceId           String
  practice             Practice           @relation(fields: [practiceId], references: [id])
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])
  engagementId         String
  engagement           Engagement         @relation(fields: [engagementId, practiceId], references: [id, practiceId])

  basis    FeeBasis
  currency String   @default("INR") @db.Char(3)

  /// The agreed headline amount. For TIME_BASED this is null and
  /// `agreedRateAmount` carries the rate instead.
  agreedAmount Decimal? @db.Decimal(18, 2)

  /// FIN01: an agreed rate, recorded per unit, with the unit named. A timer
  /// may report hours; it may not supply the price of one.
  agreedRateAmount Decimal? @db.Decimal(18, 2)
  agreedRateUnit   String?

  /// RECURRING only — "monthly", "quarterly". Kept as the agreed words rather
  /// than a schedule the system invents.
  recurrenceLabel String?

  /// FIN01 "agreed tax treatment". The full FIN03 particulars (place of
  /// supply, SAC, reverse charge) are R1; what R0 records is what the
  /// engagement letter said the treatment would be.
  taxTreatment   String
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  status           FeeArrangementStatus @default(DRAFT)
  approvedByUserId String?
  approvedByName   String?
  approvedAt       DateTime?

  /// DAT02: particulars frozen at approval, so later master-data edits cannot
  /// rewrite what was agreed.
  approvedSnapshot Json?

  // FIN01 scope change — same shape as ENG04's engagement revisions.
  parentArrangementId String?
  parent              FeeArrangement?  @relation("FeeRevision", fields: [parentArrangementId], references: [id])
  revisions           FeeArrangement[] @relation("FeeRevision")
  revisionNumber      Int              @default(0)
  supersededAt        DateTime?
  changeReason        String?

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  components FeeComponent[]
  invoices   Invoice[]

  @@unique([id, practiceId])
  @@index([practiceId, engagementId, status])
}

/// FIN01 milestones, reimbursable expenses and advances. Each is billable
/// once: `invoicedAt` is what stops a milestone being charged twice.
model FeeComponent {
  id            String         @id @default(uuid())
  practiceId    String
  arrangementId String
  arrangement   FeeArrangement @relation(fields: [arrangementId, practiceId], references: [id, practiceId])

  kind        FeeComponentKind
  description String
  amount      Decimal          @db.Decimal(18, 2)
  dueOn       DateTime?        @db.Date

  reachedAt   DateTime?
  invoicedAt  DateTime?
  invoiceId   String?

  createdAt DateTime @default(now())

  @@unique([id, practiceId])
  @@index([practiceId, arrangementId])
}

// ---------------------------------------------------------------------------
// FIN02 corrections
// ---------------------------------------------------------------------------

/// FIN02: "Issued particulars are locked; corrections use reviewed credit /
/// debit notes." A credit note is therefore a document in its own right, with
/// its own number, its own review and its own immutable snapshot — not an
/// adjustment written back onto the invoice.
model CreditNote {
  id         String        @id @default(uuid())
  practiceId String
  practice   Practice      @relation(fields: [practiceId], references: [id])
  seriesId   String
  series     InvoiceSeries @relation(fields: [seriesId, practiceId], references: [id, practiceId])
  invoiceId  String
  invoice    Invoice       @relation(fields: [invoiceId, practiceId], references: [id, practiceId])

  /// NULL until issue, for the same reason as Invoice.sequenceNumber.
  sequenceNumber Int?
  displayNumber  String?

  reason   String
  amount   Decimal          @db.Decimal(18, 2)
  currency String           @default("INR") @db.Char(3)
  status   CreditNoteStatus @default(DRAFT)

  // "Reviewed" is the operative word in FIN02 — a correction one person can
  // raise and issue alone is not reviewed.
  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?

  issuedSnapshot Json?
  issuedAt       DateTime?
  cancelledAt    DateTime?

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations ReceiptAllocation[]

  @@unique([id, practiceId])
  @@unique([seriesId, sequenceNumber])
  @@index([practiceId, invoiceId])
}

// ---------------------------------------------------------------------------
// Approval / filing
// ---------------------------------------------------------------------------

enum ApprovalSubjectType {
  ENGAGEMENT
  INVOICE
  DOCUMENT_VERSION
  OBLIGATION
  FILING
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  WITHDRAWN
}

// API02: an approval names the EXACT subject version it was given against,
// so approving a stale version can be detected and refused.
model Approval {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  subjectType    ApprovalSubjectType
  subjectId      String
  subjectVersion Int

  actorUserId String?
  // DAT03 evidence: the name is denormalised so a purged account still
  // leaves an identifiable historical approval, without keeping secrets.
  actorDisplayName String
  authority        String

  decision  ApprovalDecision
  decidedAt DateTime         @default(now())
  comments  String?

  sourceFileSha256  String?
  externalReference String?
  acknowledgedAt    DateTime?

  @@unique([practiceId, subjectType, subjectId, subjectVersion, decidedAt])
  @@index([practiceId, subjectType, subjectId])
}

// ---------------------------------------------------------------------------
// Event / integration / AI job
// ---------------------------------------------------------------------------

enum EventResult {
  SUCCESS
  FAILURE
}

// SEC03 append-only audit trail. Rows are inserted, never updated or deleted.
model Event {
  id         String    @id @default(uuid())
  tenantId   String?
  tenant     Tenant?   @relation(fields: [tenantId], references: [id])
  practiceId String?
  practice   Practice? @relation(fields: [practiceId], references: [id])

  actorUserId          String?
  actorUser            User?   @relation(fields: [actorUserId], references: [id])
  actorServiceIdentity String?

  targetType    String
  targetId      String
  action        String
  correlationId String?

  beforeMeta Json?
  afterMeta  Json?

  ruleVersion  String?
  modelVersion String?

  result       EventResult
  errorMessage String?
  reason       String?

  // SEC04: exact version of the record the action applied to.
  targetVersion Int?

  createdAt DateTime @default(now())

  // SEC04 tamper evidence. `sequence`, `previousHash` and `hash` are written
  // by a database trigger, never by the application — so an attacker with
  // application-level access cannot rewrite history and recompute the chain.
  // Any gap or mismatch when the chain is walked proves interference.
  sequence     BigInt  @default(autoincrement())
  previousHash String?
  hash         String?

  @@index([practiceId, createdAt])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@index([sequence])
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertKind {
  FAILED_LOGIN_BURST
  ABNORMAL_EXPORT
  PRIVILEGE_CHANGE
  REPEATED_CROSS_SCOPE_ACCESS
  QUEUE_FAILURE
  STORAGE_CAPACITY
  BACKUP_FAILURE
  SECRET_REVEAL
}

/// SEC05 — monitoring and incidents.
///
/// An alert names an owner and a destination, and carries only the metadata
/// needed to investigate. It deliberately does NOT carry document contents or
/// secret values: "Detection should preserve evidence without sending
/// confidential files to an unrestricted alert channel."
model SecurityAlert {
  id         String   @id @default(uuid())
  practiceId String?

  kind     AlertKind
  severity AlertSeverity

  subjectUserId String?
  summary       String
  // Counts, ids and timestamps only — never file bodies or secret values.
  evidence      Json

  incidentOwner    String
  alertDestination String

  acknowledgedAt     DateTime?
  acknowledgedByName String?
  resolvedAt         DateTime?
  resolutionNote     String?

  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([practiceId, resolvedAt])
}

// ---------------------------------------------------------------------------
// Communication and client requests — COM01-04 (PRD §16)
// COM05 (meetings) is R1; COM06 (WhatsApp / other channels) is R2.
// ---------------------------------------------------------------------------

/// COM01: "Distinguish internal discussion from client visible conversation."
/// Two values only, deliberately. A third "maybe" state is how internal notes
/// leak — either the client can read it or they cannot.
enum ThreadVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum MessageDirection {
  INTERNAL_NOTE
  OUTBOUND_TO_CLIENT
  INBOUND_FROM_CLIENT
}

/// The medium a message arrived or left by. EMAIL_REFERENCE is a pointer to
/// correspondence that happened in a mail client — the thread records that it
/// exists and where; it does not claim to be the mail system.
enum MessageChannel {
  PORTAL
  EMAIL_REFERENCE
  NOTE
  MEETING_SUMMARY
}

/// COM01 — the unified context. A thread hangs off the client relationship and
/// optionally narrows to an engagement or job, so "everything said about this
/// client" and "everything said about this audit" are the same records read at
/// two widths rather than two parallel inboxes that drift apart.
model MessageThread {
  id                   String             @id @default(uuid())
  practiceId           String
  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])

  engagementId String?
  engagement   Engagement? @relation(fields: [engagementId, practiceId], references: [id, practiceId])
  jobId        String?
  job          Job?        @relation(fields: [jobId, practiceId], references: [id, practiceId])

  subject    String
  visibility ThreadVisibility @default(INTERNAL)

  /// API02 optimistic concurrency — a visibility change is exactly the kind of
  /// consequential edit that must not silently last-write-win.
  version Int @default(1)

  createdByUserId String
  closedAt        DateTime?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  messages          Message[]
  visibilityChanges ThreadVisibilityChange[]
  outboundMessages  OutboundMessage[]

  @@unique([id, practiceId])
  @@index([practiceId, clientRelationshipId, updatedAt])
  @@index([practiceId, engagementId])
}

model Message {
  id         String        @id @default(uuid())
  practiceId String
  threadId   String
  thread     MessageThread @relation(fields: [threadId, practiceId], references: [id, practiceId])

  direction MessageDirection
  channel   MessageChannel

  /// Per-message visibility. A thread being made client-visible does NOT
  /// silently expose every message it contains: each message carries its own
  /// classification, and COM01's preview is what reconciles the two.
  visibility ThreadVisibility

  body String

  authorUserId    String?
  authorContactId String?
  /// DAT02: the author's name at the time, so a later rename or deactivation
  /// does not rewrite who said what.
  authorName String

  /// COM01: an email reference points at correspondence held elsewhere. The
  /// message records the reference, never a scraped copy of the mailbox.
  externalReference String?

  /// Document versions attached to this message, as version ids. Exact
  /// versions, never "the latest" — DOC04's rule applied to conversation.
  attachedVersionIds String[] @default([])

  redactedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([practiceId, threadId, createdAt])
}

/// COM01: "A user must not change a thread's visibility without previewing all
/// included content."
///
/// The preview is a RECORD, not a UI step. It captures a digest of exactly what
/// was shown; committing the change requires that digest, and the digest is
/// recomputed from live content at commit time. If a message was added or
/// changed after the preview, the digest no longer matches and the change is
/// refused — so a preview cannot wave through content nobody saw.
model ThreadVisibilityChange {
  id         String        @id @default(uuid())
  practiceId String
  threadId   String
  thread     MessageThread @relation(fields: [threadId, practiceId], references: [id, practiceId])

  fromVisibility ThreadVisibility
  toVisibility   ThreadVisibility

  /// SHA-256 over the canonical list of message ids + their visibility + a
  /// hash of each body, in a fixed order.
  contentDigest     String
  previewedCount    Int
  previewedByUserId String
  previewedAt       DateTime @default(now())

  committedAt       DateTime?
  committedByUserId String?
  abandonedAt       DateTime?
  refusalReason     String?

  @@index([practiceId, threadId, previewedAt])
}

// ------------------------------------------------------------------ COM02

/// COM02: "A received file stops that item's reminder only after the
/// configured received / accepted rule."
enum RequestCloseRule {
  ON_RECEIPT
  ON_ACCEPTANCE
}

/// The response state of ONE requested item. A client may submit, explain
/// nonavailability, or ask a question — all three are legitimate responses and
/// only one of them is a document.
enum RequestItemState {
  OUTSTANDING
  SUBMITTED
  NOT_AVAILABLE
  QUESTION_RAISED
  ACCEPTED
  REJECTED
  WAIVED
}

/// COM02 — the itemisation. "one upload cannot close all requests" is enforced
/// structurally: reminders are suppressed per ITEM, and a response names the
/// single item it answers.
model ClientRequestItem {
  id         String        @id @default(uuid())
  practiceId String
  requestId  String
  request    ClientRequest @relation(fields: [requestId, practiceId], references: [id, practiceId])

  sequence     Int
  documentType String
  description  String?
  /// The period the item covers, as the client would name it ("FY 2025-26 Q1").
  periodLabel  String?
  periodStart  DateTime? @db.Date
  periodEnd    DateTime? @db.Date

  dueDate     DateTime? @db.Date
  ownerUserId String?

  state          RequestItemState @default(OUTSTANDING)
  stateChangedAt DateTime?

  /// Set when the item stops generating reminders, which is NOT the same
  /// instant as receiving a file unless the close rule says so.
  remindersStoppedAt DateTime?

  /// API02 optimistic concurrency.
  version Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  responses     ClientRequestItemResponse[]
  portalUploads PortalUpload[]

  @@unique([id, practiceId])
  @@unique([requestId, sequence])
  @@index([practiceId, state, dueDate])
}

enum RequestResponseKind {
  DOCUMENT
  NOT_AVAILABLE_EXPLANATION
  QUESTION
  STAFF_NOTE
}

/// One response answers ONE item. Nothing here can fan out across items, which
/// is what makes "a client corrects an item and only that request clears" true
/// by construction rather than by care.
model ClientRequestItemResponse {
  id         String            @id @default(uuid())
  practiceId String
  itemId     String
  item       ClientRequestItem @relation(fields: [itemId, practiceId], references: [id, practiceId])

  kind RequestResponseKind

  documentVersionId String?
  explanation       String?

  respondedByContactId String?
  respondedByUserId    String?
  respondedByName      String

  /// The staff decision on this response, under the ON_ACCEPTANCE rule.
  acceptedAt       DateTime?
  acceptedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?

  supersededAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([practiceId, itemId, createdAt])
}

// ------------------------------------------------------------------ COM03

/// COM03: "Templates contain no client data until rendered within the
/// authorised scope." A template is stored with placeholders only; the render
/// happens at send time, inside a scope check, and the rendered body lives on
/// the OutboundMessage, never back on the template.
model MessageTemplate {
  id         String  @id @default(uuid())
  practiceId String?
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id])

  code    String
  name    String
  subject String
  /// Placeholders are {{dotted.paths}}. Stored text is checked to hold no
  /// literal identifier-shaped values before it can be activated.
  body    String

  /// Service communication only. Marketing needs a separately reviewed policy
  /// (PRD §16 closing note), so it is not a value this field offers.
  purpose String @default("SERVICE")

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

/// COM04 delivery states, logged separately as the PRD requires. Deliberately
/// a NEW enum rather than a retype of DeliveryState (used by ObligationAlert):
/// the two lifecycles differ, and retyping a live column is the destructive
/// migration this project has been bitten by before.
///
/// SUBMITTED means the provider accepted the message. It is NOT DELIVERED, and
/// neither state is proof of reading or filing.
enum OutboundState {
  QUEUED
  HELD_QUIET_HOURS
  /// BCP03: "Pause outbound messages and filings until queued actions are
  /// reconciled so restoration cannot resend historical communications."
  /// A restore moves every QUEUED message here. It is a distinct state rather
  /// than a reuse of SUPPRESSED because these messages were never suppressed
  /// by a policy decision — they are waiting on a human to confirm they are
  /// still wanted, and the difference matters to whoever reads the log.
  HELD_RESTORE_RECONCILIATION
  SUBMITTED
  DELIVERED
  FAILED
  SUPPRESSED
  DELIVERY_UNCERTAIN
}

enum OutboundKind {
  CLIENT_MESSAGE
  DOCUMENT_REQUEST_REMINDER
  DEADLINE_REMINDER
  INVOICE
  DOCUMENT_RELEASE
  DIGEST
}

/// COM03/COM04 — the send record.
///
/// Everything shown in the confirmation screen is snapshotted here and hashed;
/// the send is refused unless the hash the user confirmed still matches what
/// would actually go out. That closes the gap between "what I reviewed" and
/// "what was sent" that a re-render between preview and send would otherwise
/// open.
model OutboundMessage {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  threadId String?
  thread   MessageThread? @relation(fields: [threadId, practiceId], references: [id, practiceId])

  clientRelationshipId String?
  kind                 OutboundKind

  /// COM03 sender identity, snapshotted. `sendingPracticeName` is the practice
  /// the recipient will see; binding it to practiceId at send time is what
  /// stops a Company invoice leaving under an Associates identity.
  sendingPracticeName String
  fromIdentity        String
  replyToIdentity     String
  letterheadId        String?

  templateId      String?
  renderedSubject String
  renderedBody    String

  /// Exact document versions attached, and the portal links offered instead.
  attachedVersionIds String[] @default([])
  portalLinkTokenIds String[] @default([])

  /// SHA-256 over the canonical preview: practice, from, reply-to, sorted
  /// recipient addresses, subject, body, sorted attachment version ids.
  previewHash              String
  previewConfirmedAt       DateTime?
  previewConfirmedByUserId String?

  /// COM04 duplicate key: one logical message per event per recipient set.
  /// Unique, so two workers racing the same reminder cannot both insert.
  dedupKey String @unique

  state        OutboundState @default(QUEUED)
  stateDetail  String?
  scheduledFor DateTime?
  submittedAt  DateTime?
  deliveredAt  DateTime?

  attemptCount Int @default(0)
  maxAttempts  Int @default(3)

  requestedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  recipients OutboundRecipient[]
  attempts   DeliveryAttempt[]

  @@unique([id, practiceId])
  @@index([practiceId, state, scheduledFor])
  @@index([practiceId, kind, createdAt])
}

/// A recipient as it stood at send time. Held separately from Contact so a
/// later change to the contact record cannot rewrite who a message went to.
model OutboundRecipient {
  id         String          @id @default(uuid())
  practiceId String
  messageId  String
  message    OutboundMessage @relation(fields: [messageId, practiceId], references: [id, practiceId])

  contactId String?
  address   String
  name      String
  role      String  @default("TO")

  /// COM03: the authority that justified sending to this address, resolved
  /// live at send time, recorded here as evidence.
  authorityBasis String

  /// True when the address differs from the contact's verified channel and had
  /// to clear a separate verification. Recorded so a reader can tell the
  /// difference between "the usual address" and "a new one someone supplied".
  wasChangedRecipient Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([practiceId, messageId])
}

/// COM03: "Verify changed external recipients separately."
///
/// A verification is a separate act with its own actor and evidence — it is not
/// satisfied by the person who introduced the new address typing it twice.
model RecipientVerification {
  id         String @id @default(uuid())
  practiceId String

  contactId String?
  address   String

  previousAddress  String?
  proposedByUserId String?
  proposedByName   String

  verifiedAt           DateTime?
  verifiedByUserId     String?
  verifiedByName       String?
  verificationMethod   String?
  verificationEvidence String?

  refusedAt     DateTime?
  refusalReason String?

  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([practiceId, address, verifiedAt])
}

// ------------------------------------------------------------------ COM04

/// Each transmission attempt, kept separately from the message so the retry
/// history survives whatever the final state is.
model DeliveryAttempt {
  id         String          @id @default(uuid())
  practiceId String
  messageId  String
  message    OutboundMessage @relation(fields: [messageId, practiceId], references: [id, practiceId])

  attemptNo Int
  state     OutboundState
  /// The provider's own response. Provider acceptance is logged as evidence of
  /// ACCEPTANCE, never promoted to delivery.
  providerReference String?
  detail            String?

  /// A bounce is a fact about the channel, not an acknowledgement by a person.
  /// DUE03's rule restated: it can never count as receipt.
  isBounce   Boolean @default(false)
  bounceKind String?

  createdAt DateTime @default(now())

  @@unique([messageId, attemptNo])
  @@index([practiceId, createdAt])
}

enum DigestMode {
  IMMEDIATE
  DAILY_DIGEST
  WEEKLY_DIGEST
}

/// COM04 quiet hours and digest options, per recipient. Held per practice so a
/// contact who deals with both firms is not silenced in one by a preference set
/// in the other.
model NotificationPreference {
  id         String  @id @default(uuid())
  practiceId String
  contactId  String?
  userId     String?

  digestMode DigestMode @default(IMMEDIATE)

  /// Local-time minutes from midnight. Quiet hours may wrap past midnight
  /// (e.g. 1290 -> 480), which the engine handles explicitly.
  quietFromMinute Int?
  quietToMinute   Int?
  timeZone        String @default("Asia/Kolkata")

  /// Statutory deadline alerts can be marked exempt from quiet hours by an
  /// explicit decision — but that is a decision, not the default.
  quietHoursOverrideKinds OutboundKind[] @default([])

  suppressedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practiceId, contactId])
  @@unique([practiceId, userId])
}

// ---------------------------------------------------------------------------
// Client portal — POR01-03, POR05 (PRD §17), T13.
//
// PRD §17 closes with "Separate portal authentication from internal staff
// administration." That is why none of these models touch `User`, `Session` or
// `Invitation`: a client contact is not a staff member with fewer permissions,
// it is a different kind of principal entirely. Authority to act still comes
// from ContactAuthority — nothing here grants access on its own.
// ---------------------------------------------------------------------------

/// POR02 invitation. Distinct from `Invitation`, which carries a PracticeRole
/// and creates a staff account; this one names an existing client CONTACT and
/// grants nothing beyond what ContactAuthority already allows them to do.
model PortalInvitation {
  id         String  @id @default(uuid())
  practiceId String
  contactId  String
  contact    Contact @relation(fields: [contactId], references: [id])

  /// Only the SHA-256, as with staff sessions: a database or backup copy
  /// cannot be replayed as a live invitation.
  tokenHash String   @unique
  expiresAt DateTime

  invitedByUserId String?
  invitedByName   String

  /// POR02 "single use". Set at redemption, checked before every redemption,
  /// never cleared — a used invitation stays used.
  acceptedAt DateTime?

  revokedAt     DateTime?
  revokedReason String?

  /// POR05 "clear recovery for expired links". A renewal is requested with the
  /// dead token itself, which is what lets the request be routed to the right
  /// engagement team WITHOUT the visitor having to name the client.
  renewalRequestedAt DateTime?
  renewalCount       Int       @default(0)

  createdAt DateTime @default(now())

  @@index([practiceId, contactId])
  @@index([expiresAt])
}

/// Portal session. Deliberately mirrors `Session`'s shape (hash-only token,
/// idle + absolute expiry, server-side revocation) but keys on Contact, and is
/// carried in its own cookie so a portal token can never be presented as a
/// staff token or the reverse.
model PortalSession {
  id         String  @id @default(uuid())
  contactId  String
  contact    Contact @relation(fields: [contactId], references: [id])
  practiceId String

  tokenHash String @unique

  userAgent String?

  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime

  revokedAt     DateTime?
  revokedReason String?

  uploads PortalUpload[]

  @@index([contactId, revokedAt])
  @@index([practiceId])
}

enum PortalUploadState {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// POR03 resumable upload.
///
/// The acceptance evidence is "interrupted upload resumes without duplicate
/// originals", so the resume identity has to be established BEFORE any bytes
/// move, not inferred afterwards: the client declares total size and digest up
/// front and gets back an upload id, and every part it sends names its own
/// index. Re-sending a part it already sent overwrites that part rather than
/// appending a second copy, and the assembled bytes are content-addressed on
/// completion — so even a client that restarts from zero lands on the same
/// object key and the same DocumentVersion.
model PortalUpload {
  id         String @id @default(uuid())
  practiceId String

  clientRelationshipId String
  clientRelationship   ClientRelationship @relation(fields: [clientRelationshipId, practiceId], references: [id, practiceId])

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  sessionId String?
  session   PortalSession? @relation(fields: [sessionId], references: [id])

  /// The request item this satisfies. POR03 guides "by service and period",
  /// which is exactly what the item already carries.
  itemId String?
  item   ClientRequestItem? @relation(fields: [itemId, practiceId], references: [id, practiceId])

  filename         String
  declaredMimeType String
  expectedBytes    Int
  /// Declared by the client at the start. Verified against the assembled bytes
  /// at completion — a mismatch fails the upload rather than filing a
  /// document nobody can vouch for.
  expectedSha256 String?

  receivedBytes Int               @default(0)
  state         PortalUploadState @default(IN_PROGRESS)

  /// Set once the parts have been assembled and accepted through DOC01 intake.
  completedAt       DateTime?
  intakeId          String?
  documentVersionId String?
  /// Records that completion found the identical content already filed for
  /// this item — the "no duplicate original" outcome, kept visible rather than
  /// silently succeeding.
  deduplicatedFromVersionId String?

  abandonedAt   DateTime?
  abandonReason String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parts PortalUploadPart[]

  @@unique([id, practiceId])
  @@index([practiceId, contactId, state])
  @@index([expiresAt])
}

/// One received chunk. `@@unique([uploadId, partNumber])` is what makes a
/// resumed transfer idempotent: the same part arriving twice updates one row.
model PortalUploadPart {
  id       String       @id @default(uuid())
  uploadId String
  upload   PortalUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  partNumber Int
  sizeBytes  Int
  sha256     String
  objectKey  String

  receivedAt DateTime @default(now())

  @@unique([uploadId, partNumber])
  @@index([uploadId])
}

/// POR05 "call / message route using verified firm contact details configured
/// by the owner". Owner-configured and explicitly verified — an unverified row
/// is not shown to a client, because a support number nobody checked is worse
/// than no number at all.
model PracticeSupportContact {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  label      String
  phone      String?
  email      String?
  helpUrl    String?
  hoursLabel String?

  verifiedAt DateTime?
  verifiedBy String?

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime?
  archivedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([practiceId, archivedAt])
}

// ---------------------------------------------------------------------------
// API03 — transactional outbox (T15)
// ---------------------------------------------------------------------------

enum OutboxState {
  PENDING
  /// BCP03, same reason as OutboundState.HELD_RESTORE_RECONCILIATION: a
  /// restored PENDING event would otherwise fire a side effect that already
  /// happened. The dispatcher only claims PENDING rows, so parking them here
  /// stops delivery without deleting the evidence that they existed.
  HELD_RESTORE_RECONCILIATION
  DISPATCHED
  FAILED
  DEAD
}

/// API03 "Commit important business events with the transaction through an
/// outbox. Consumers are idempotent. Preserve action keys, retries, scheduled
/// time and executed time. A failed external side effect does not roll back a
/// valid approval into an unknown state."
///
/// The row is written by the SAME transaction that made the business change,
/// so the event cannot exist without the change and the change cannot exist
/// without the event. Delivery happens afterwards, outside that transaction —
/// which is precisely why a dead SMTP server cannot un-approve an approval.
model OutboxEvent {
  id         String  @id @default(uuid())
  tenantId   String?
  practiceId String?

  eventType String

  /// The caller's idempotency key. Two clicks that mean the same intent carry
  /// the same key, and the unique index — not application logic — is what
  /// makes the second one a no-op. Nullable for events with no natural key.
  actionKey String? @unique

  /// The exact record version the event describes (API02/SEC04). An event
  /// about version 3 must never be replayed against version 4.
  subjectType    String
  subjectId      String
  subjectVersion Int?

  payload Json

  /// API01: the same ID the originating HTTP response carried, so a support
  /// question about one response can be traced to its side effects.
  correlationId String?

  state    OutboxState @default(PENDING)
  attempts Int         @default(0)
  maxAttempts Int      @default(5)
  lastError   String?

  /// Preserved separately and never collapsed into one column: WHEN the event
  /// became due, and WHEN it actually ran. A retry that succeeds an hour late
  /// must still show that it was due an hour ago.
  occurredAt   DateTime  @default(now())
  scheduledFor DateTime  @default(now())
  executedAt   DateTime?

  /// Set while a dispatcher holds the row, so two dispatchers cannot both
  /// deliver the same event.
  claimedAt   DateTime?
  claimedBy   String?

  receipts OutboxConsumerReceipt[]

  @@index([state, scheduledFor])
  @@index([practiceId, subjectType, subjectId])
}

/// API03 "Consumers are idempotent." Idempotency is enforced here rather than
/// trusted to each consumer: the receipt is inserted in the same transaction
/// as the consumer's own work, so a consumer that has already run cannot run
/// a second time even if the dispatcher redelivers.
model OutboxConsumerReceipt {
  id      String      @id @default(uuid())
  eventId String
  event   OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  consumer String

  result    String
  detail    String?
  handledAt DateTime @default(now())

  @@unique([eventId, consumer])
  @@index([consumer, handledAt])
}

// ---------------------------------------------------------------------------
// BCP01-04, BCP06 — backup, recovery and operational continuity (T18, PRD §37)
// BCP05 (structured export and vendor exit) is R1 and deliberately absent.
// ---------------------------------------------------------------------------

/// BCP01 names the scope explicitly: "the database, object versions,
/// configuration, templates, necessary keys / recovery material and audit
/// events". Each is a separate artifact kind so a backup that silently stopped
/// capturing one of them shows up as a MISSING ROW, not as a slightly smaller
/// archive nobody looked at.
enum BackupArtifactKind {
  DATABASE_ROWS
  DATABASE_NATIVE_DUMP
  OBJECT_MANIFEST
  OBJECT_PAYLOAD
  CONFIGURATION
  TEMPLATE
  KEY_INVENTORY
  AUDIT_EVENTS
}

enum BackupRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model BackupRun {
  id       String  @id @default(uuid())
  tenantId String?

  /// The moment the data in this backup was true. RPO is measured from HERE,
  /// never from completedAt — a run that took twenty minutes did not capture
  /// the twenty minutes it spent running.
  dataAsOf    DateTime
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  status        BackupRunStatus @default(RUNNING)
  failureReason String?

  /// Where the working copy landed, and the separate-failure-domain copy.
  /// Both are recorded because a copy that lives only beside the database it
  /// protects is not a backup (BCP01).
  primaryLocation String
  offsiteLocation String?

  /// An immutable / offline copy "where feasible". False is an honest answer
  /// and is reported as a gap rather than quietly omitted.
  immutableCopy Boolean @default(false)

  encrypted Boolean @default(true)
  /// The NAME of the key that wrapped it. Never the key.
  encryptionKeyId String?

  /// SHA-256 over the manifest, so the SET is tamper-evident as a whole and
  /// not merely artifact by artifact — otherwise a dropped artifact leaves
  /// every remaining hash still correct.
  manifestSha256 String

  sizeBytes       BigInt  @default(0)
  createdByUserId String?

  artifacts BackupArtifact[]
  restores  RestoreRun[]

  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([status, dataAsOf])
}

model BackupArtifact {
  id          String    @id @default(uuid())
  backupRunId String
  backupRun   BackupRun @relation(fields: [backupRunId], references: [id], onDelete: Cascade)

  kind BackupArtifactKind
  name String

  /// Hash of the PLAINTEXT bytes. A restore must be able to prove it got back
  /// what was taken, not merely that some ciphertext decrypted cleanly.
  sha256      String
  sizeBytes   BigInt  @default(0)
  recordCount Int?
  encrypted   Boolean @default(true)
  storedAt    String

  createdAt DateTime @default(now())

  @@unique([backupRunId, kind, name])
  @@index([kind, sha256])
}

enum RestoreStatus {
  RUNNING
  RECONCILING
  HELD
  COMPLETED
  FAILED
}

/// The reconciliation categories BCP03 requires: object manifests, hashes and
/// database references, plus the access decisions that must SURVIVE a restore
/// rather than being rolled back to how they looked before someone was
/// removed or something was erased.
enum RestoreCheckCategory {
  OBJECT_HASH
  OBJECT_REFERENCE
  PERMISSION
  LEGAL_HOLD
  ERASURE
  OBLIGATION
  RECEIPT_BALANCE
  OUTBOUND_HOLD
  AUDIT_CHAIN
}

model RestoreRun {
  id          String    @id @default(uuid())
  backupRunId String
  backupRun   BackupRun @relation(fields: [backupRunId], references: [id])

  targetLabel String

  /// BCP03. Both must be true before a single restored row is written. A
  /// restore into a reachable environment that can still send is exactly how
  /// a recovery re-mails last month's invoices.
  isolated                Boolean
  externalSendingDisabled Boolean

  dataAsOf  DateTime
  startedAt DateTime  @default(now())
  /// When the restored core first answered — the end of RTO.
  usableAt    DateTime?
  completedAt DateTime?

  measuredRpoSeconds Int?
  measuredRtoSeconds Int?
  rpoTargetSeconds   Int
  rtoTargetSeconds   Int
  /// Null until BOTH were measured. An unmeasured target is not a met target.
  targetsMet Boolean?

  /// BCP03: outbound stays held until reconciliation passes. A null release
  /// time on a finished restore means it is STILL held, deliberately.
  outboundHeldFrom         DateTime  @default(now())
  outboundReleasedAt       DateTime?
  outboundReleasedByUserId String?
  quarantinedOutboundCount Int       @default(0)

  status        RestoreStatus @default(RUNNING)
  failureReason String?

  checks RestoreCheck[]
  drills RestoreDrill[]

  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([status, startedAt])
}

model RestoreCheck {
  id           String     @id @default(uuid())
  restoreRunId String
  restoreRun   RestoreRun @relation(fields: [restoreRunId], references: [id], onDelete: Cascade)

  category RestoreCheckCategory
  subject  String
  expected String
  actual   String
  passed   Boolean
  detail   String?

  checkedAt DateTime @default(now())

  @@index([restoreRunId, category, passed])
}

/// BCP06 names the three failures a drill must actually rehearse. They are an
/// enum rather than free text so "we tested recovery" cannot stand in for
/// "we tested losing the only administrator".
enum DrillScenario {
  SCHEDULED_QUARTERLY
  PRIMARY_SERVER_LOSS
  KEY_SERVICE_UNAVAILABLE
  SOLE_ADMINISTRATOR_DEPARTED
}

model RestoreDrill {
  id           String      @id @default(uuid())
  restoreRunId String?
  restoreRun   RestoreRun? @relation(fields: [restoreRunId], references: [id])

  scenario          DrillScenario
  performedAt       DateTime      @default(now())
  performedByUserId String?

  achievedRpoSeconds Int?
  achievedRtoSeconds Int?

  /// Structured, not prose: BCP06 asks for "missing items, exceptions and
  /// remediation owner", and a drill must not be able to pass by being written
  /// up well.
  missingItems String[]
  exceptions   String[]

  remediationOwnerUserId String?
  remediationOwnerName   String
  remediationDueAt       DateTime?
  remediationClosedAt    DateTime?

  notes String?

  /// Next drill due — quarterly by default (BCP06 "periodically thereafter,
  /// proposed quarterly").
  nextDueAt DateTime

  version   Int      @default(1)
  createdAt DateTime @default(now())

  @@index([scenario, performedAt])
}

/// BCP04 lists what can fail independently of the core: "internet, email, AI
/// or connector outages". Database, object store and queue are added because
/// the same screen has to tell a user which local functions still work.
enum MonitoredService {
  DATABASE
  OBJECT_STORE
  QUEUE
  INTERNET
  EMAIL
  AI
  CONNECTOR
}

enum ServiceState {
  OPERATIONAL
  DEGRADED
  OFFLINE
  UNKNOWN
}

model ServiceStatusRecord {
  id      String           @id @default(uuid())
  service MonitoredService @unique

  state ServiceState @default(UNKNOWN)

  /// When the CURRENT state began — not when it was last polled. A user needs
  /// "email has been down for three hours", not "checked one second ago".
  since     DateTime @default(now())
  checkedAt DateTime @default(now())
  detail    String?

  /// BCP04: "Keep work queues and local functions available where
  /// infrastructure permits." What still works is part of the status, because
  /// a red dot with no guidance just stops the office.
  degradedGuidance String?

  version Int @default(1)
}

/// BCP04: "a procedure for recording work performed during downtime when the
/// core returns." Kept deliberately separate from Job and TimeEntry until a
/// human reconciles it — an unreconciled downtime note must never silently
/// become billable or completed work.
model DowntimeWorkRecord {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  recordedByUserId String

  /// When the work actually happened, which is not when it was typed in.
  occurredAt DateTime
  recordedAt DateTime @default(now())

  service     MonitoredService?
  description String

  jobId        String?
  obligationId String?

  reconciledAt       DateTime?
  reconciledByUserId String?
  reconciliationNote String?

  version Int @default(1)

  @@index([practiceId, reconciledAt])
}

// ---------------------------------------------------------------------------
// T19 — privacy, retention and regulatory clocks (PRD §36 PRV01, PRV02, PRV04,
// PRV06). PRV03 (rights requests) and PRV05 (DPDP breach workflow) are R1.
// ---------------------------------------------------------------------------

/// PRV01: "Do not treat consent as the only possible basis for every
/// professional record." Most of a CA practice's records exist because a
/// statute or a professional duty requires them, and recording them as
/// consent-based would imply a withdrawal could erase them.
enum LegalBasis {
  LEGAL_OBLIGATION
  PROFESSIONAL_DUTY
  CONTRACT_PERFORMANCE
  LEGITIMATE_USE
  CONSENT
}

enum ProcessingStatus {
  DRAFT
  ACTIVE
  RETIRED
}

/// PRV01 processing register — one row per processing purpose, per practice.
/// Each practice is responsible for its own register; the two are never merged.
model ProcessingActivity {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  name            String
  purpose         String
  dataCategories  String[]
  source          String
  accessRoles     PracticeRole[]
  recipients      String[]
  vendor          String?
  // Free text on purpose: the hosting decision (PRD §46) is still open, and
  // the register must be able to say "UNCONFIRMED" rather than guess.
  hostingLocation String
  retentionClass  String
  legalBasis      LegalBasis
  // The specific statute, clause or engagement term — a basis without an
  // authority is an assertion, not a record.
  legalAuthority  String
  noticeReference        String?
  consentRecordReference String?

  status    ProcessingStatus @default(DRAFT)
  ownerName String

  createdByUserId String
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([practiceId, name])
  @@unique([id, practiceId])
}

/// PRV02: "Track Enacted, Notified, Operational, Prospective and Superseded
/// requirements with sources and effective rules."
enum RegulatoryState {
  ENACTED
  NOTIFIED
  PROSPECTIVE
  OPERATIONAL
  SUPERSEDED
}

model RegulatoryRequirement {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  code            String
  title           String
  instrument      String
  state           RegulatoryState
  sourceReference String
  sourceDate      DateTime  @db.Date
  // The date the rule takes effect, where one is known. OPERATIONAL is refused
  // without one that has arrived.
  effectiveFrom   DateTime? @db.Date
  effectiveRule   String

  supersededByCode String?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stateChanges RegulatoryStateChange[]

  @@unique([practiceId, code])
  @@unique([id, practiceId])
}

/// Append-only history of a requirement's legal state, so an incident assessed
/// last year can be read against the state the law had THEN.
model RegulatoryStateChange {
  id            String                @id @default(uuid())
  practiceId    String
  requirementId String
  requirement   RegulatoryRequirement @relation(fields: [requirementId, practiceId], references: [id, practiceId])

  fromState       RegulatoryState?
  toState         RegulatoryState
  sourceReference String
  sourceDate      DateTime  @db.Date
  effectiveFrom   DateTime? @db.Date
  reason          String

  changedByUserId String
  changedByName   String
  changedAt       DateTime @default(now())

  @@index([requirementId, changedAt])
}

/// PRV04: "Keep this assessment distinct from routine support incidents and
/// future DPDP clocks."
enum IncidentTrack {
  SECURITY
  ROUTINE_SUPPORT
}

enum CertInAssessment {
  PENDING
  APPLICABLE
  NOT_APPLICABLE
}

enum RootCauseStatus {
  UNKNOWN
  INVESTIGATING
  IDENTIFIED
}

enum IncidentClockRegime {
  CERT_IN_6H
  DPDP_AFFECTED_PERSONS
  DPDP_BOARD_INITIAL
  DPDP_BOARD_DETAILED_72H
}

model SecurityIncident {
  id         String   @id @default(uuid())
  practiceId String
  practice   Practice @relation(fields: [practiceId], references: [id])

  title   String
  track   IncidentTrack
  summary String

  // The clocks run from AWARENESS: not from when the record was typed in, and
  // not from when the root cause was found.
  awarenessAt DateTime
  recordedAt  DateTime @default(now())

  certInAssessment CertInAssessment @default(PENDING)
  certInCategory   String?
  certInReason     String?
  assessedByUserId String?
  assessedByName   String?
  assessedAt       DateTime?

  rootCause     RootCauseStatus @default(UNKNOWN)
  rootCauseNote String?

  // The T06 alert that raised it, if one did. Ids only.
  securityAlertId String?

  reportedByUserId String
  reportedByName   String
  closedAt         DateTime?

  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports            IncidentReport[]
  awarenessRevisions IncidentAwarenessRevision[]

  @@unique([id, practiceId])
  @@index([practiceId, closedAt])
}

/// A report actually made to an authority under one regime. A clock's state
/// is derived from these and the awareness time, never stored as a flag that
/// could say "met" without a report behind it.
model IncidentReport {
  id         String           @id @default(uuid())
  practiceId String
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId, practiceId], references: [id, practiceId])

  regime           IncidentClockRegime
  reportedAt       DateTime
  reference        String
  recordedByUserId String
  recordedByName   String
  createdAt        DateTime @default(now())

  @@unique([incidentId, regime])
}

/// Awareness corrections. Only an EARLIER time is accepted: re-dating
/// awareness later would extend a statutory clock after the fact.
model IncidentAwarenessRevision {
  id         String           @id @default(uuid())
  practiceId String
  incidentId String
  incident   SecurityIncident @relation(fields: [incidentId, practiceId], references: [id, practiceId])

  previousAwarenessAt DateTime
  newAwarenessAt      DateTime
  reason              String
  revisedByUserId     String
  revisedByName       String
  revisedAt           DateTime @default(now())
}

/// PRV06 acceptance evidence: "An erasure request for an engagement under
/// legal hold is reviewed and partially actioned where appropriate, with
/// reasons." (The verified rights-request workflow around it is PRV03, R1.)
enum ErasureState {
  REQUESTED
  REVIEWED
  PARTIALLY_ACTIONED
  ACTIONED
  ALL_RETAINED
}

enum ErasureItemKind {
  DOCUMENT
  CONTACT_PHONE
  CONTACT_EMAIL
  AUDIT_TRAIL
}

enum ErasureDecision {
  ERASE
  RETAIN
}

model ErasureRequest {
  id           String     @id @default(uuid())
  practiceId   String
  practice     Practice   @relation(fields: [practiceId], references: [id])
  engagementId String
  engagement   Engagement @relation(fields: [engagementId, practiceId], references: [id, practiceId])
  contactId    String?

  receivedVia String
  requestText String
  state       ErasureState @default(REQUESTED)

  requestedByUserId String
  requestedByName   String
  requestedAt       DateTime @default(now())

  reviewedByUserId String?
  reviewedByName   String?
  reviewedAt       DateTime?
  actionedAt       DateTime?
  outcomeSummary   String?

  version Int @default(1)

  items ErasureItem[]

  @@unique([id, practiceId])
  @@index([practiceId, state])
}

model ErasureItem {
  id         String         @id @default(uuid())
  practiceId String
  requestId  String
  request    ErasureRequest @relation(fields: [requestId, practiceId], references: [id, practiceId])

  kind     ErasureItemKind
  targetId String
  label    String

  // What the system found — a legal hold, a retention floor, audit evidence.
  // When set, ERASE is refused whatever the reviewer chooses.
  mustRetainReason String?

  decision ErasureDecision?
  reason   String?

  actionedAt        DateTime?
  deletionRequestId String?

  @@unique([requestId, kind, targetId])
}
